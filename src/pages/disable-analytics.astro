---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Umami 统计控制"
  description="控制当前浏览器是否计入 Umami 访问统计。"
  noindex={true}
  analytics={false}
>
  <div class="shell page narrow analytics-control">
    <p class="eyebrow">UMAMI</p>
    <h1 id="status">正在检查统计设置…</h1>
    <p id="detail" class="detail"></p>
    <p id="hint" class="hint"></p>

    <div class="actions" aria-label="Umami 统计控制">
      <a class="control-button" href="?disabled=1">禁止统计</a>
      <a class="control-button" href="?disabled=0">恢复统计</a>
    </div>
  </div>

  <script is:inline>
    const status = document.getElementById("status");
    const detail = document.getElementById("detail");
    const hint = document.getElementById("hint");
    const params = new URLSearchParams(window.location.search);
    const requested = params.get("disabled");

    try {
      if (requested === "1") {
        localStorage.setItem("umami.disabled", "1");
      } else if (requested === "0") {
        localStorage.removeItem("umami.disabled");
      }

      const disabled = localStorage.getItem("umami.disabled") === "1";

      if (disabled) {
        status.textContent = "当前浏览器已禁用 Umami 统计。";
        detail.innerHTML = '已为 <code>thinkerqaq.github.io</code> 保存 <code>umami.disabled = "1"</code>。';
      } else {
        status.textContent = "当前浏览器已启用 Umami 统计。";
        detail.innerHTML = '<code>thinkerqaq.github.io</code> 当前没有设置 <code>umami.disabled</code>。';
      }

      if (requested === "1") {
        hint.textContent = "已禁止统计。现在可以关闭此页面。";
      } else if (requested === "0") {
        hint.textContent = "已恢复统计。之后打开的普通博客页面可以再次被 Umami 统计。";
      } else {
        hint.textContent = "使用下方按钮控制当前浏览器是否计入 Umami 统计。";
      }
    } catch (_) {
      status.textContent = "无法更新 Umami 统计设置。";
      detail.textContent = "当前浏览器阻止了对 localStorage 的访问。";
      hint.textContent = "统计设置没有发生变化。";
    }
  </script>
</BaseLayout>

<style>
  .analytics-control h1 {
    margin: 0;
    font-weight: 760;
    line-height: 1.16;
    letter-spacing: -0.045em;
  }

  .detail {
    margin: 1.25rem 0 0;
    color: var(--muted);
  }

  .hint {
    margin: 0.45rem 0 0;
    color: var(--faint);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .control-button {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    box-shadow: var(--shadow);
  }

  .control-button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  :global(.analytics-control code) {
    padding: 0.12em 0.35em;
    border-radius: 0.35rem;
    background: var(--accent-soft);
    color: var(--text);
    font-size: 0.9em;
  }
</style>
