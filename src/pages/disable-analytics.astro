<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Disable analytics · ThinkerQAQ</title>
    <script is:inline>
      try {
        localStorage.setItem("umami.disabled", "1");
      } catch (_) {
        // The status below will report the failure.
      }
    </script>
    <style>
      :root {
        color-scheme: light dark;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        box-sizing: border-box;
      }

      main {
        width: min(560px, 100%);
      }

      h1 {
        margin: 0 0 12px;
        font-size: 1.6rem;
      }

      p {
        line-height: 1.6;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
    </style>
  </head>
  <body>
    <main>
      <h1 id="status">Checking analytics setting…</h1>
      <p id="detail"></p>
      <p>You can close this page after the setting is confirmed.</p>
    </main>

    <script is:inline>
      const status = document.getElementById("status");
      const detail = document.getElementById("detail");

      try {
        const disabled = localStorage.getItem("umami.disabled") === "1";
        if (disabled) {
          status.textContent = "Umami tracking is disabled on this browser.";
          detail.innerHTML = 'Stored as <code>umami.disabled = "1"</code> for <code>thinkerqaq.github.io</code>.';
        } else {
          status.textContent = "Could not disable Umami tracking.";
          detail.textContent = "This browser did not persist the localStorage setting.";
        }
      } catch (_) {
        status.textContent = "Could not disable Umami tracking.";
        detail.textContent = "This browser blocked access to localStorage.";
      }
    </script>
  </body>
</html>
