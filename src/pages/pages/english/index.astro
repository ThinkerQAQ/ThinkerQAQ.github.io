---
import { getCollection } from "astro:content";
import ArticleList from "../../components/ArticleList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleIsIncluded, sortArticles } from "../../lib/content";
const entries = sortArticles(
  (await getCollection("articles")).filter(
    (entry) => articleIsIncluded(entry) && entry.data.language === "en",
  ),
);
---
<BaseLayout
  title="English Articles"
  language="en"
  locale="en"
  canonicalPath="/en/articles/"
  languageAlternatives={[]}
  noindex={true}
>
  <div class="shell page">
    <header class="page-header"><h1>English Articles</h1></header>
    <ArticleList entries={entries} locale="en" emptyMessage="No English articles published yet." />
    <p><a href="/en/articles/">Open the current English article index</a></p>
  </div>
</BaseLayout>
