---
import { getCollection, type CollectionEntry } from "astro:content";
import CollectionHeader from "../../../components/CollectionHeader.astro";
import ShowcaseList from "../../../components/ShowcaseList.astro";
import { SERIES_UI } from "../../../config/i18n-features";
import { LOCALES, localizePath, nonDefaultLocales, type Locale } from "../../../config/i18n";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  articleIsIncluded,
  localizedSeriesSummary,
  seriesHref,
  seriesStatusLabel,
  sortSeries,
} from "../../../lib/content";
import {
  seriesHasLocaleSummary,
  translatedSeriesArticleCount,
} from "../../../lib/series-i18n";

export async function getStaticPaths() {
  const entries = sortSeries(await getCollection("series"));
  const articles = (await getCollection("articles")).filter(articleIsIncluded);
  return nonDefaultLocales().map((locale) => ({
    params: { locale: LOCALES[locale].path },
    props: { locale, entries, articles },
  }));
}

interface Props {
  locale: Locale;
  entries: CollectionEntry<"series">[];
  articles: CollectionEntry<"articles">[];
}

const { locale, entries, articles } = Astro.props;
const localeInfo = LOCALES[locale];
const seriesUi = SERIES_UI[locale];
const localizedSeries = entries.filter((entry) => seriesHasLocaleSummary(entry, locale));
---

<BaseLayout
  title={localeInfo.ui.seriesTitle}
  description={localeInfo.ui.seriesDescription}
  noindex={localizedSeries.length === 0}
  locale={locale}
  canonicalPath={localizePath(locale, "/series/")}
>
  <div class="shell page collection-page">
    <CollectionHeader title={localeInfo.ui.seriesTitle} description={localeInfo.ui.seriesDescription} />
    {localizedSeries.length === 0 ? (
      <p class="empty-state">{localeInfo.ui.seriesEmpty}</p>
    ) : (
      <ShowcaseList items={localizedSeries.map((entry) => {
        const summary = localizedSeriesSummary(entry, locale);
        const translatedArticleCount = translatedSeriesArticleCount(entry, articles, locale);
        return {
          href: seriesHref(entry, locale),
          title: summary.title,
          description: summary.description,
          label: seriesUi.articleProgress(translatedArticleCount, entry.data.relatedArticles.length),
          status: seriesStatusLabel(entry.data.status, locale),
        };
      })} />
    )}
  </div>
</BaseLayout>
