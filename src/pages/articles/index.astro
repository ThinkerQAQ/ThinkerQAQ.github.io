---
import { getCollection } from "astro:content";
import ArticleIndex from "../../components/ArticleIndex.astro";
import Pagination from "../../components/Pagination.astro";
import { ARTICLE_PAGE_SIZE } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleIsIncluded, sortArticles } from "../../lib/content";

const articles = sortArticles(
  (await getCollection("articles")).filter(articleIsIncluded),
);
const chineseArticles = articles.filter((article) => article.data.language === "zh");
const englishArticles = articles.filter((article) => article.data.language === "en");
const pageCount = Math.ceil(chineseArticles.length / ARTICLE_PAGE_SIZE);
const nextUrl = pageCount > 1 ? "/articles/page/2/" : undefined;
---

<BaseLayout title="文章" noindex={articles.length === 0}>
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}
  <div class="shell page article-index-page">
    <ArticleIndex articles={[...chineseArticles.slice(0, ARTICLE_PAGE_SIZE), ...englishArticles]} />
    <Pagination
      currentPage={1}
      lastPage={pageCount}
      nextUrl={nextUrl}
    />
  </div>
</BaseLayout>
