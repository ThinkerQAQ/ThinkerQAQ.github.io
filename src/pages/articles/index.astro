---
import { getCollection } from "astro:content";
import ArticleIndex from "../../components/ArticleIndex.astro";
import Pagination from "../../components/Pagination.astro";
import {
  DEFAULT_LOCALE,
  SUPPORTED_LOCALES,
  type LocaleAlternative,
} from "../../config/i18n";
import { ARTICLE_PAGE_SIZE } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  articleIndexHref,
  articleIsIncluded,
  articlePageHref,
  sortArticles,
} from "../../lib/content";

const articles = sortArticles(
  (await getCollection("articles")).filter(articleIsIncluded),
);
const localizedArticles = articles.filter(
  (article) => article.data.language === DEFAULT_LOCALE,
);
const pageCount = Math.ceil(localizedArticles.length / ARTICLE_PAGE_SIZE);
const nextUrl = pageCount > 1 ? articlePageHref(2, DEFAULT_LOCALE) : undefined;
const languageAlternatives: LocaleAlternative[] = SUPPORTED_LOCALES
  .filter((locale) => articles.some((article) => article.data.language === locale))
  .map((locale) => ({ locale, href: articleIndexHref(locale) }));
---

<BaseLayout
  title="文章"
  noindex={localizedArticles.length === 0}
  locale={DEFAULT_LOCALE}
  languageAlternatives={languageAlternatives}
>
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}
  <div class="shell page article-index-page">
    <ArticleIndex
      articles={localizedArticles.slice(0, ARTICLE_PAGE_SIZE)}
      locale={DEFAULT_LOCALE}
    />
    <Pagination
      currentPage={1}
      lastPage={pageCount}
      nextUrl={nextUrl}
    />
  </div>
</BaseLayout>
