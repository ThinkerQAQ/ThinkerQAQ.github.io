---
import type { GetStaticPathsOptions, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import ArticleIndex from "../../../components/ArticleIndex.astro";
import Pagination from "../../../components/Pagination.astro";
import {
  DEFAULT_LOCALE,
  nonDefaultLocales,
  type LocaleAlternative,
} from "../../../config/i18n";
import { ARTICLE_PAGE_SIZE } from "../../../config/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  articleIsIncluded,
  articlePageHref,
  sortArticles,
} from "../../../lib/content";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = sortArticles(
    (await getCollection("articles")).filter(
      (article) => articleIsIncluded(article) && article.data.language === DEFAULT_LOCALE,
    ),
  );

  return paginate(articles, { pageSize: ARTICLE_PAGE_SIZE }).filter(
    ({ params }) => params.page !== "1",
  );
}

interface Props {
  page: Page<CollectionEntry<"articles">>;
}

const { page } = Astro.props;
const currentUrl = articlePageHref(page.currentPage, DEFAULT_LOCALE);
const prevUrl = articlePageHref(page.currentPage - 1, DEFAULT_LOCALE);
const nextUrl = page.currentPage < page.lastPage
  ? articlePageHref(page.currentPage + 1, DEFAULT_LOCALE)
  : undefined;
const allArticles = sortArticles(
  (await getCollection("articles")).filter(articleIsIncluded),
);
const firstItemIndex = (page.currentPage - 1) * ARTICLE_PAGE_SIZE;
const languageAlternatives: LocaleAlternative[] = [DEFAULT_LOCALE, ...nonDefaultLocales()]
  .filter(
    (locale) =>
      allArticles.filter((article) => article.data.language === locale).length > firstItemIndex,
  )
  .map((locale) => ({ locale, href: articlePageHref(page.currentPage, locale) }));
---

<BaseLayout
  title={`文章 · 第 ${page.currentPage} 页`}
  canonicalPath={currentUrl}
  noindex={page.data.length === 0}
  locale={DEFAULT_LOCALE}
  languageAlternatives={languageAlternatives}
>
  <link slot="head" rel="prev" href={prevUrl} />
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}
  <div class="shell page article-index-page">
    <ArticleIndex articles={page.data} locale={DEFAULT_LOCALE} />
    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      nextUrl={nextUrl}
      prevUrl={prevUrl}
    />
  </div>
</BaseLayout>
