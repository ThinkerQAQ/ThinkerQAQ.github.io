---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { articleIsIncluded } from "../../lib/content";

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).filter(articleIsIncluded);
  return articles.map((article) => {
    if (article.data.updatedAt && article.data.updatedAt < article.data.publishedAt) {
      throw new Error(`Article ${article.id}: updatedAt precedes publishedAt`);
    }
    const translation = article.data.translationOf
      ? articles.find((candidate) => candidate.id === article.data.translationOf)
      : articles.find((candidate) => candidate.data.translationOf === article.id);
    if (article.data.translationOf && !translation) {
      throw new Error(`Article ${article.id}: published translation not found`);
    }
    if (translation && (translation.id === article.id || translation.data.language === article.data.language)) {
      throw new Error(`Article ${article.id}: translation must be a different-language article`);
    }
    const translations = articles.filter((candidate) => candidate.data.translationOf === article.id);
    if (translations.length > 1 || (article.data.translationOf && translations.length > 0)) {
      throw new Error(`Article ${article.id}: use one translationOf link per bilingual pair`);
    }
    return { params: { slug: article.id }, props: { article, translation } };
  });
}

interface Props {
  article: CollectionEntry<"articles">;
  translation?: CollectionEntry<"articles">;
}

const { article, translation } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout article={article} headings={headings} translation={translation}>
  <Content />
</ArticleLayout>
