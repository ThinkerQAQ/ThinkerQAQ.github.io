---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { DEFAULT_LOCALE } from "../../config/i18n";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import {
  articleIsIncluded,
  getArticleSeriesNavigation,
  getArticleTranslations,
} from "../../lib/content";
import {
  buildArticleNoteRelationIndex,
  getRelatedNotesForArticle,
} from "../../lib/content-relations";
import { getArticleProjectRelation, type ProjectRelation } from "../../lib/project-relations";

export async function getStaticPaths() {
  const allArticles = await getCollection("articles");
  const articles = allArticles.filter(articleIsIncluded);
  const notes = await getCollection("notes");
  const relationIndex = buildArticleNoteRelationIndex(allArticles, notes);
  const seriesEntries = await getCollection("series");
  const projects = await getCollection("projects");
  const routeArticles = articles.filter(
    (article) =>
      article.data.language === DEFAULT_LOCALE ||
      !article.id.startsWith(`${article.data.language}/`),
  );

  return routeArticles.map((article) => {
    if (article.data.updatedAt && article.data.updatedAt < article.data.publishedAt) {
      throw new Error(`Article ${article.id}: updatedAt precedes publishedAt`);
    }
    const translations = getArticleTranslations(article, articles);
    const seriesNavigation = getArticleSeriesNavigation(article, articles, seriesEntries);
    const relatedNotes = getRelatedNotesForArticle(article, relationIndex);
    const projectRelation = getArticleProjectRelation(article, allArticles, seriesEntries, projects);
    return {
      params: { slug: article.id },
      props: { article, translations, seriesNavigation, relatedNotes, projectRelation },
    };
  });
}

interface Props {
  article: CollectionEntry<"articles">;
  translations: CollectionEntry<"articles">[];
  seriesNavigation?: import("../../lib/content").ArticleSeriesNavigation;
  relatedNotes: CollectionEntry<"notes">[];
  projectRelation?: ProjectRelation;
}

const { article, translations, seriesNavigation, relatedNotes, projectRelation } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(article);
const rawReadingMinutes = Number(remarkPluginFrontmatter.readingMinutes);
const readingMinutes = Number.isFinite(rawReadingMinutes) && rawReadingMinutes > 0
  ? Math.ceil(rawReadingMinutes)
  : 1;
---

<ArticleLayout
  article={article}
  headings={headings}
  readingMinutes={readingMinutes}
  translations={translations}
  seriesNavigation={seriesNavigation}
  relatedNotes={relatedNotes}
  projectRelation={projectRelation}
>
  <Content />
</ArticleLayout>
