---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { articleIsIncluded } from "../lib/content";
const counts = await Promise.all([
  getCollection("notes"),
  getCollection("articles").then((articles) => articles.filter(articleIsIncluded)),
  getCollection("projects"),
  getCollection("series"),
]);
const hasContent = counts.some((entries) => entries.length > 0);
---

<BaseLayout title="搜索" description="搜索 ThinkerQAQ 的技术文章与学习笔记。" noindex={true}>
  <div class="shell page search-page" data-search-page>
    <h1 class="visually-hidden">搜索</h1>
    {hasContent ? <>
    <div class="search-page__content">
      <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
      <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
      <pagefind-config base-url="/"></pagefind-config>
      <div class="search-page__brand" aria-hidden="true">
        <img src="/favicon.ico" alt="" width="64" height="64" />
        <span>ThinkerQAQ</span>
      </div>
      <pagefind-input class="search-page__input" placeholder="搜索本站内容"></pagefind-input>
      <div class="search-page__results">
        <pagefind-summary></pagefind-summary>
        <pagefind-results></pagefind-results>
      </div>
      <noscript>搜索功能需要启用 JavaScript，但文章正文不需要。</noscript>
    </div>
    </> : <p class="empty-state">暂无可搜索的内容。</p>}
  </div>
</BaseLayout>

<script is:inline>
  const searchPage = document.querySelector("[data-search-page]");
  const pagefindInput = searchPage?.querySelector("pagefind-input");

  const updateSearchLayout = () => {
    requestAnimationFrame(() => {
      const input = pagefindInput?.querySelector("input");
      searchPage?.classList.toggle("search-page--active", Boolean(input?.value.trim()));
    });
  };

  pagefindInput?.addEventListener("input", updateSearchLayout);
  pagefindInput?.addEventListener("click", updateSearchLayout);
  pagefindInput?.addEventListener("keydown", updateSearchLayout);
</script>
