---
import AboutProfile from "../components/AboutProfile.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profilePageSchema } from "../lib/structured-data";

const description = "关于 ThinkerQAQ：一名关注后端工程与基础设施的软件工程师，记录技术、学习与生活。";
const profileSchema = profilePageSchema({
  path: "/about/",
  name: "关于 ThinkerQAQ",
  description,
  inLanguage: "zh-CN",
});
---
<BaseLayout
  title="关于我"
  description={description}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(profileSchema).replaceAll("<", "\\u003c")}
  />
  <div class="shell page narrow collection-page">
    <AboutProfile locale="zh" />
  </div>
</BaseLayout>
