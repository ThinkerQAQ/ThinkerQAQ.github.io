---
import { getEntry } from "astro:content";
import AboutContent from "../components/AboutContent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profilePageSchema } from "../lib/structured-data";

const entry = await getEntry("pages", "about");
if (!entry || entry.data.language !== "zh") {
  throw new Error("Missing Chinese About page at src/content/pages/about.md");
}
const profileSchema = profilePageSchema({
  path: "/about/",
  name: "关于 ThinkerQAQ",
  description: entry.data.seoDescription,
  inLanguage: "zh-CN",
});
---
<BaseLayout title={entry.data.title} description={entry.data.seoDescription}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(profileSchema).replaceAll("<", "\\u003c")}
  />
  <div class="shell page collection-page">
    <AboutContent entry={entry} />
  </div>
</BaseLayout>
