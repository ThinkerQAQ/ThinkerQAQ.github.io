---
import AboutProfile from "../../components/AboutProfile.astro";
import { LOCALES, localizePath, nonDefaultLocales, type Locale } from "../../config/i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profilePageSchema } from "../../lib/structured-data";

export function getStaticPaths() {
  return nonDefaultLocales().map((locale) => ({
    params: { locale: LOCALES[locale].path },
    props: { locale },
  }));
}

interface Props { locale: Locale }
const { locale } = Astro.props;
const localeInfo = LOCALES[locale];
const aboutPath = localizePath(locale, "/about/");
const profileSchema = profilePageSchema({
  path: aboutPath,
  name: `About ThinkerQAQ`,
  description: localeInfo.ui.aboutDescription,
  inLanguage: localeInfo.htmlLang,
});
---

<BaseLayout
  title={localeInfo.ui.aboutTitle}
  description={localeInfo.ui.aboutDescription}
  canonicalPath={aboutPath}
  locale={locale}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(profileSchema).replaceAll("<", "\\u003c")}
  />
  <div class="shell page narrow collection-page">
    <AboutProfile locale={locale} />
  </div>
</BaseLayout>
