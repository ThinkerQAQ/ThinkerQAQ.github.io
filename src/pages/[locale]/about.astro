---
import { getEntry } from "astro:content";
import AboutContent from "../../components/AboutContent.astro";
import { LOCALES, localizePath, nonDefaultLocales, type Locale } from "../../config/i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profilePageSchema } from "../../lib/structured-data";

export function getStaticPaths() {
  return nonDefaultLocales().map((locale) => ({
    params: { locale: LOCALES[locale].path },
    props: { locale },
  }));
}

interface Props { locale: Locale }
const { locale } = Astro.props;
const entry = await getEntry("pages", `${locale}/about`);
if (!entry || entry.data.language !== locale) {
  throw new Error(`Missing ${locale} About page at src/content/pages/${locale}/about.md`);
}
const localeInfo = LOCALES[locale];
const aboutPath = localizePath(locale, "/about/");
const profileSchema = profilePageSchema({
  path: aboutPath,
  name: `About ThinkerQAQ`,
  description: entry.data.seoDescription,
  inLanguage: localeInfo.htmlLang,
});
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.seoDescription}
  canonicalPath={aboutPath}
  locale={locale}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(profileSchema).replaceAll("<", "\\u003c")}
  />
  <div class="shell page collection-page">
    <AboutContent entry={entry} />
  </div>
</BaseLayout>
