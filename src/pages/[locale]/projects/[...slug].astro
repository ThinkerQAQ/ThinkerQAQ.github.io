---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProjectKnowledgeIndex from "../../../components/ProjectKnowledgeIndex.astro";
import { LOCALES, nonDefaultLocales, type Locale } from "../../../config/i18n";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  formatDate,
  localizedProjectSummary,
  projectHref,
  projectStatusLabel,
} from "../../../lib/content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return nonDefaultLocales().flatMap((locale) => projects.map((project) => ({
    params: { locale: LOCALES[locale].path, slug: project.id },
    props: { locale, project },
  })));
}

interface Props {
  locale: Locale;
  project: CollectionEntry<"projects">;
}

const { locale, project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const summary = localizedProjectSummary(project, locale);
const hasTranslation = Boolean(data.translations?.[locale]);
const articles = await getCollection("articles");
const seriesEntries = await getCollection("series");
---

<BaseLayout
  title={summary.title}
  description={summary.description}
  canonicalPath={projectHref(project, locale)}
  locale={locale}
  noindex={!hasTranslation}
>
  <div class="shell page detail-page">
    <article>
      <header class="note-header detail-page-header">
        <h1>{summary.title}</h1>
        <p class="note-description">{summary.description}</p>
        <div class="note-meta">
          <span>{projectStatusLabel(data.status, locale)}</span>
          <span>{LOCALES[locale].ui.updatedAt} {formatDate(data.updatedAt, locale)}</span>
        </div>
      </header>
      {!hasTranslation && <p class="source-note">The project body is currently maintained in Chinese.</p>}
      <div class="prose" lang={!hasTranslation ? "zh-CN" : LOCALES[locale].htmlLang}><Content /></div>
      <ProjectKnowledgeIndex
        project={project}
        articles={articles}
        seriesEntries={seriesEntries}
        locale={locale}
      />
    </article>
  </div>
</BaseLayout>
