---
import CollectionHeader from "../../components/CollectionHeader.astro";
import { LOCALES, localizePath, nonDefaultLocales, type Locale } from "../../config/i18n";
import { SITE } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return nonDefaultLocales().map((locale) => ({
    params: { locale: LOCALES[locale].path },
    props: { locale },
  }));
}

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<BaseLayout
  title="Contact"
  description="Contact ThinkerQAQ through GitHub for technical discussions, article feedback, or collaboration."
  canonicalPath={localizePath(locale, "/contact/")}
  locale={locale}
>
  <div class="shell page narrow collection-page">
    <CollectionHeader
      title="Contact"
      description="For technical discussions, article feedback, or collaboration, please contact me through GitHub."
    />

    <div class="prose">
      <h2>GitHub</h2>
      <p>
        <a href={SITE.contact}>github.com/ThinkerQAQ</a>
      </p>
      <p>
        For code, project, or article-specific topics, use the relevant GitHub repository or discussion entry point.
      </p>
    </div>
  </div>
</BaseLayout>
