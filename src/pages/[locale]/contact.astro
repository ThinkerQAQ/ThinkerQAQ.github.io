---
import CollectionHeader from "../../components/CollectionHeader.astro";
import { LOCALES, localizePath, nonDefaultLocales, type Locale } from "../../config/i18n";
import { SITE } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return nonDefaultLocales().map((locale) => ({
    params: { locale: LOCALES[locale].path },
    props: { locale },
  }));
}

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<BaseLayout
  title="Contact"
  description="Email ThinkerQAQ for technical discussions, article feedback, or collaboration."
  canonicalPath={localizePath(locale, "/contact/")}
  locale={locale}
>
  <div class="shell page narrow collection-page">
    <CollectionHeader
      title="Contact"
      description="For technical discussions, article feedback, or collaboration, reach me by email."
    />

    <div class="prose">
      <h2>Email</h2>
      <p>
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
      </p>
      <h2>GitHub</h2>
      <p>
        <a href={SITE.github}>github.com/ThinkerQAQ</a>
      </p>
      <p>
        For code or project-specific questions, you can also start a discussion in the relevant GitHub repository.
      </p>
    </div>
  </div>
</BaseLayout>
