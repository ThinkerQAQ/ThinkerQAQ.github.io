---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { DEFAULT_LOCALE, localePathSegment } from "../../../config/i18n";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import {
  articleIsIncluded,
  articleSlug,
  getArticleSeriesNavigation,
  getArticleTranslations,
} from "../../../lib/content";

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).filter(articleIsIncluded);
  const seriesEntries = await getCollection("series");

  return articles
    .filter((article) => article.data.language !== DEFAULT_LOCALE)
    .map((article) => {
      if (article.data.updatedAt && article.data.updatedAt < article.data.publishedAt) {
        throw new Error(`Article ${article.id}: updatedAt precedes publishedAt`);
      }
      const translations = getArticleTranslations(article, articles);
      const seriesNavigation = getArticleSeriesNavigation(article, articles, seriesEntries);
      return {
        params: {
          locale: localePathSegment(article.data.language),
          slug: articleSlug(article),
        },
        props: { article, translations, seriesNavigation },
      };
    });
}

interface Props {
  article: CollectionEntry<"articles">;
  translations: CollectionEntry<"articles">[];
  seriesNavigation?: import("../../../lib/content").ArticleSeriesNavigation;
}

const { article, translations, seriesNavigation } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout
  article={article}
  headings={headings}
  translations={translations}
  seriesNavigation={seriesNavigation}
>
  <Content />
</ArticleLayout>
