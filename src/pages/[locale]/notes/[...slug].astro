---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { LOCALES, nonDefaultLocales, type Locale } from "../../../config/i18n";
import NoteLayout from "../../../layouts/NoteLayout.astro";
import { getNoteCollectionNavigation, type NoteCollectionNavigation } from "../../../lib/content";
import {
  buildArticleNoteRelationIndex,
  getRelatedArticlesForNote,
} from "../../../lib/content-relations";
import {
  localizeNotes,
  noteTranslationFor,
  type NoteTranslationEntry,
} from "../../../lib/note-i18n";

export async function getStaticPaths() {
  const [notes, translations, articles] = await Promise.all([
    getCollection("notes"),
    getCollection("noteTranslations"),
    getCollection("articles"),
  ]);
  const relationIndex = buildArticleNoteRelationIndex(articles, notes);

  return nonDefaultLocales().flatMap((locale) => {
    const localizedNotes = localizeNotes(notes, translations, locale);
    return notes.map((note, index) => ({
      params: { locale: LOCALES[locale].path, slug: note.id },
      props: {
        locale,
        note: localizedNotes[index]!,
        translation: noteTranslationFor(note, translations, locale),
        collectionNavigation: getNoteCollectionNavigation(localizedNotes[index]!, localizedNotes),
        relatedArticles: getRelatedArticlesForNote(note, locale, articles, relationIndex),
      },
    }));
  });
}

interface Props {
  locale: Locale;
  note: CollectionEntry<"notes">;
  translation?: NoteTranslationEntry;
  collectionNavigation: NoteCollectionNavigation;
  relatedArticles: CollectionEntry<"articles">[];
}

const { locale, note, translation, collectionNavigation, relatedArticles } = Astro.props;
const rendered = translation ? await render(translation) : await render(note);
const { Content, headings, remarkPluginFrontmatter } = rendered;
const rawReadingMinutes = Number(remarkPluginFrontmatter.readingMinutes);
const readingMinutes = Number.isFinite(rawReadingMinutes) && rawReadingMinutes > 0
  ? Math.ceil(rawReadingMinutes)
  : 1;
---

<NoteLayout
  note={note}
  headings={headings}
  collectionNavigation={collectionNavigation}
  readingMinutes={readingMinutes}
  locale={locale}
  relatedArticles={relatedArticles}
>
  <Content />
</NoteLayout>
