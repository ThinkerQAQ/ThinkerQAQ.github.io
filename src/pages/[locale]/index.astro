---
import { getCollection, type CollectionEntry } from "astro:content";
import ArticleIndex from "../../components/ArticleIndex.astro";
import Pagination from "../../components/Pagination.astro";
import { LOCALES, localizePath, nonDefaultLocales, type Locale } from "../../config/i18n";
import { ARTICLE_PAGE_SIZE } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { articleIndexHref, articleIsIncluded, articlePageHref, sortArticles } from "../../lib/content";

export async function getStaticPaths() {
  const articles = sortArticles((await getCollection("articles")).filter(articleIsIncluded));
  return nonDefaultLocales().map((locale) => ({
    params: { locale: LOCALES[locale].path },
    props: { locale, articles },
  }));
}

interface Props {
  locale: Locale;
  articles: CollectionEntry<"articles">[];
}

const { locale, articles } = Astro.props;
const localeInfo = LOCALES[locale];
const localizedArticles = articles.filter((article) => article.data.language === locale);
const pageCount = Math.ceil(localizedArticles.length / ARTICLE_PAGE_SIZE);
const nextUrl = pageCount > 1 ? articlePageHref(2, locale) : undefined;
const homeHref = localizePath(locale, "/");
---

<BaseLayout
  description={localeInfo.ui.articlesDescription}
  noindex={localizedArticles.length === 0}
  locale={locale}
  canonicalPath={homeHref}
>
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}
  <div class="shell page article-index-page">
    <ArticleIndex articles={localizedArticles.slice(0, ARTICLE_PAGE_SIZE)} locale={locale} />
    <Pagination
      currentPage={1}
      lastPage={pageCount}
      firstPageUrl={homeHref}
      pageUrlPrefix={`${articleIndexHref(locale)}page/`}
      nextUrl={nextUrl}
      locale={locale}
    />
  </div>
</BaseLayout>
