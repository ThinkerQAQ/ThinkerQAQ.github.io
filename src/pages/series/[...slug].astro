---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ArticleList from "../../components/ArticleList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteCategoryPreview from "../../components/NoteCategoryPreview.astro";
import { articleIsIncluded, formatDate, groupByCategory, seriesStatus } from "../../lib/content";
export async function getStaticPaths() {
  return (await getCollection("series")).map((series) => ({ params: { slug: series.id }, props: { series } }));
}
interface Props { series: CollectionEntry<"series"> }
const { series } = Astro.props;
const { data } = series;
const articles = await getCollection("articles");
const notes = await getCollection("notes");
function resolveEntries<T extends { id: string }>(ids: string[], entries: T[]): T[] {
  return ids.map((id) => {
    const entry = entries.find((item) => item.id === id);
    if (!entry) throw new Error(`Series ${series.id}: referenced content not found: ${id}`);
    return entry;
  });
}
const relatedArticles = resolveEntries(data.relatedArticles, articles).filter(articleIsIncluded);
const noteCategories = new Map(groupByCategory(notes).map((group) => [group.category, group]));
const relatedNoteCategories = data.relatedNoteCategories.map((category) => {
  const group = noteCategories.get(category);
  if (!group) throw new Error(`Series ${series.id}: referenced note category not found: ${category}`);
  return group;
});
---
<BaseLayout title={data.title} description={data.description}>
  <div class="shell page detail-page">
    <article data-pagefind-body>
      <header class="note-header detail-page-header"><h1 data-pagefind-meta="title">{data.title}</h1><p class="note-description">{data.description}</p><div class="note-meta"><span>{seriesStatus[data.status]}</span><span>更新于 {formatDate(data.updatedAt)}</span></div></header>
      <section aria-label="系列文章"><ArticleList entries={relatedArticles} emptyMessage="正式文章还在整理中，可以先阅读下方参考笔记。" /></section>
    </article>
    {relatedNoteCategories.length > 0 && (
      <section class="related-content series-reference-notes" aria-labelledby="reference-notes-heading">
        <h2 id="reference-notes-heading">参考笔记</h2>
        <div class="category-index">
          {relatedNoteCategories.map((group) => (
            <NoteCategoryPreview {...group} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
