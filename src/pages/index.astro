---
import HomeKnowledgeHub from "../components/HomeKnowledgeHub.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteWebsiteSchema } from "../lib/structured-data";

const websiteSchema = siteWebsiteSchema();
---

<BaseLayout>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(websiteSchema).replaceAll("<", "\\u003c")}
  />
  <HomeKnowledgeHub locale="zh" />
</BaseLayout>
