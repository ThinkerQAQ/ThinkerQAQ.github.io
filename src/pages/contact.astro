---
import CollectionHeader from "../components/CollectionHeader.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="联系"
  description="通过邮箱联系 ThinkerQAQ：技术讨论、文章反馈或合作事宜。"
  canonicalPath="/contact/"
>
  <div class="shell page narrow collection-page">
    <CollectionHeader
      title="联系"
      description="技术讨论、文章反馈或合作事宜，欢迎通过邮箱联系。"
    />

    <div class="prose">
      <h2>邮箱</h2>
      <p>
        <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
      </p>
      <h2>GitHub</h2>
      <p>
        <a href={SITE.github}>github.com/ThinkerQAQ</a>
      </p>
      <p>
        具体代码或项目问题，也可以在对应的 GitHub 仓库中讨论。
      </p>
    </div>
  </div>
</BaseLayout>
