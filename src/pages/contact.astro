---
import CollectionHeader from "../components/CollectionHeader.astro";
import { SITE } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="联系"
  description="通过 GitHub 联系 ThinkerQAQ：技术讨论、文章反馈或合作相关信息。"
  canonicalPath="/contact/"
>
  <div class="shell page narrow collection-page">
    <CollectionHeader
      title="联系"
      description="技术讨论、文章反馈或合作相关的事情，请直接通过 GitHub 联系我。"
    />

    <div class="prose">
      <h2>GitHub</h2>
      <p>
        <a href={SITE.contact}>github.com/ThinkerQAQ</a>
      </p>
      <p>
        如果是具体的代码、项目或文章问题，可以在对应仓库或页面的 GitHub 讨论入口中联系我。
      </p>
    </div>
  </div>
</BaseLayout>
