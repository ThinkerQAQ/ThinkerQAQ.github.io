---
import { getCollection } from "astro:content";
import LegacyRedirect from "../../../components/LegacyRedirect.astro";
import { noteHref } from "../../../lib/content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes
    .filter((note) => note.data.category === "java" && note.id.startsWith("java/JUC/"))
    .map((note) => ({
      params: { slug: note.id.slice("java/JUC/".length) },
      props: { target: noteHref(note) },
    }));
}

interface Props {
  target: string;
}

const { target } = Astro.props;
---

<LegacyRedirect target={target} />
