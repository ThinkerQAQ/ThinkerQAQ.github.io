---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import ContentList from "../../../../../components/ContentList.astro";
import NoteTopicIndex from "../../../../../components/NoteTopicIndex.astro";
import {
  categoryHref,
  groupNotesByTopic,
  noteTopicHref,
  ROOT_NOTE_TOPIC,
  ROOT_NOTE_TOPIC_ROUTE,
  sortNotes,
  type NoteEntry,
  type NoteTopicGroup,
} from "../../../../../lib/content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const categories = new Map<string, NoteEntry[]>();

  for (const note of notes) {
    const entries = categories.get(note.data.category) ?? [];
    entries.push(note);
    categories.set(note.data.category, entries);
  }

  return [...categories.entries()].flatMap(([category, categoryEntries]) => {
    const topics = groupNotesByTopic(categoryEntries);
    const categoryLabel = categoryEntries[0]?.data.categoryLabel ?? category;

    return topics.flatMap((topic) => {
      if (!topic.id) return [];
      const routeTopic = topic.id === ROOT_NOTE_TOPIC ? ROOT_NOTE_TOPIC_ROUTE : topic.id;
      return [{
        params: { category, topic: routeTopic },
        props: {
          entries: topic.notes,
          topics,
          total: categoryEntries.length,
          categoryLabel,
          topicLabel: topic.label,
        },
      }];
    });
  });
}

interface Props {
  entries: NoteEntry[];
  topics: NoteTopicGroup[];
  total: number;
  categoryLabel: string;
  topicLabel: string;
}

const { entries, topics, total, categoryLabel, topicLabel } = Astro.props;
const category = Astro.params.category!;
const routeTopic = Astro.params.topic!;
const topic = routeTopic === ROOT_NOTE_TOPIC_ROUTE ? ROOT_NOTE_TOPIC : routeTopic;
const sortedEntries = sortNotes(entries);
---

<BaseLayout
  title={`${topicLabel} · ${categoryLabel}`}
  description={`${categoryLabel}中的${topicLabel}学习笔记。`}
  canonicalPath={noteTopicHref(category, topic)}
  noindex={sortedEntries.length === 0}
>
  <NoteTopicIndex
    category={category}
    categoryLabel={categoryLabel}
    topics={topics}
    total={total}
    currentTopic={topic}
  >
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/notes/">笔记</a>
      <span aria-hidden="true">/</span>
      <a href={categoryHref(category)}>{categoryLabel}</a>
      <span aria-hidden="true">/</span>
      <span>{topicLabel}</span>
    </nav>

    <header class="page-header detail-page-header">
      <h1>{topicLabel}</h1>
      <p>{categoryLabel} · {sortedEntries.length} 篇笔记</p>
    </header>

    <ContentList entries={sortedEntries} showCategory={false} showTopic={false} />
  </NoteTopicIndex>
</BaseLayout>
