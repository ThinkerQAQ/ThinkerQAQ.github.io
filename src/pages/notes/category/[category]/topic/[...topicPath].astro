---
import { getCollection } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import ContentList from "../../../../../components/ContentList.astro";
import NoteTopicIndex from "../../../../../components/NoteTopicIndex.astro";
import {
  categoryHref,
  groupNotesByTopic,
  noteTopicHref,
  sortNotes,
  type NoteEntry,
  type NoteTopicGroup,
} from "../../../../../lib/content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const categories = new Map<string, NoteEntry[]>();

  for (const note of notes) {
    const entries = categories.get(note.data.category) ?? [];
    entries.push(note);
    categories.set(note.data.category, entries);
  }

  return [...categories.entries()].flatMap(([category, categoryEntries]) => {
    const topics = groupNotesByTopic(categoryEntries);
    const categoryLabel = categoryEntries[0]?.data.categoryLabel ?? category;

    return topics.flatMap((topic) => {
      if (topic.path.length === 0) return [];
      return [{
        params: {
          category,
          topicPath: topic.path.map((segment) => segment.id).join("/"),
        },
        props: {
          entries: topic.allNotes,
          topics,
          total: categoryEntries.length,
          categoryLabel,
          topic,
        },
      }];
    });
  });
}

interface Props {
  entries: NoteEntry[];
  topics: NoteTopicGroup[];
  total: number;
  categoryLabel: string;
  topic: NoteTopicGroup;
}

const { entries, topics, total, categoryLabel, topic } = Astro.props;
const category = Astro.params.category!;
const sortedEntries = sortNotes(entries);
const currentTopicPath = topic.path.map((segment) => segment.id);
const topicTitle = topic.path.map((segment) => segment.label).join(" · ");
---

<BaseLayout
  title={`${topicTitle} · ${categoryLabel}`}
  description={`${categoryLabel}中的${topic.path.map((segment) => segment.label).join(" / ")}学习笔记。`}
  canonicalPath={noteTopicHref(category, topic.path)}
  noindex={sortedEntries.length === 0}
>
  <NoteTopicIndex
    category={category}
    categoryLabel={categoryLabel}
    topics={topics}
    total={total}
    currentTopicPath={currentTopicPath}
  >
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/notes/">笔记</a>
      <span aria-hidden="true">/</span>
      <a href={categoryHref(category)}>{categoryLabel}</a>
      {topic.path.map((segment, index) => (
        <>
          <span aria-hidden="true">/</span>
          {index === topic.path.length - 1 ? (
            <span>{segment.label}</span>
          ) : (
            <a href={noteTopicHref(category, topic.path.slice(0, index + 1))}>{segment.label}</a>
          )}
        </>
      ))}
    </nav>

    <header class="page-header detail-page-header">
      <h1>{topic.label}</h1>
      <p>{categoryLabel} · {sortedEntries.length} 篇笔记</p>
    </header>

    <ContentList entries={sortedEntries} showCategory={false} showTopic={false} />
  </NoteTopicIndex>
</BaseLayout>
