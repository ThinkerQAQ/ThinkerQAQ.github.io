---
import type { GetStaticPathsOptions, Page } from "astro";
import { getCollection } from "astro:content";
import NoteCategoryIndex from "../../../../../components/NoteCategoryIndex.astro";
import { NOTE_PAGE_SIZE } from "../../../../../config/site";
import { groupNotesByTopic, sortNotes, type NoteEntry, type NoteTopicGroup } from "../../../../../lib/content";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const notes = await getCollection("notes");
  const groups = new Map<string, NoteEntry[]>();
  for (const note of notes) {
    const entries = groups.get(note.data.category) ?? [];
    entries.push(note);
    groups.set(note.data.category, entries);
  }

  return [...groups.entries()].flatMap(([category, entries]) =>
    paginate(sortNotes(entries), {
      pageSize: NOTE_PAGE_SIZE,
      params: { category },
      props: {
        label: entries[0]?.data.categoryLabel ?? category,
        topics: groupNotesByTopic(entries),
      },
    }).filter(({ params }) => params.page !== "1"),
  );
}

interface Props {
  page: Page<NoteEntry>;
  label: string;
  topics: NoteTopicGroup[];
}

const { page, label, topics } = Astro.props;
---

<NoteCategoryIndex
  category={Astro.params.category!}
  label={label}
  entries={page.data}
  topics={topics}
  total={page.total}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
/>
