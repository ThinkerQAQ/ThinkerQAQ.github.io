---
import BaseLayout from "../layouts/BaseLayout.astro";
import LifeRecord from "./LifeRecord.astro";
import Pagination from "./Pagination.astro";
import ContentMediaViewer from "./ContentMediaViewer.astro";
import ContentComments from "./ContentComments.astro";
import ContentReaction from "./ContentReaction.astro";
import { localizePath, type Locale } from "../config/i18n";
import { lifeHref, lifeTitle, type LifePageData } from "../lib/life";
import { SITE } from "../config/site";
import LifeSectionHeader from "./LifeSectionHeader.astro";

interface Props { locale: Locale; data: LifePageData; }
const { locale, data } = Astro.props;
const zh = locale === "zh";
const sectionTitle = zh ? "生活" : "Life";
const home = localizePath(locale, "/life/");
const title = data.kind === "record" ? lifeTitle(data.entry)
  : [sectionTitle, data.year, data.page > 1 ? (zh ? `第 ${data.page} 页` : `Page ${data.page}`) : undefined].filter(Boolean).join(" · ");
const description = data.kind === "record"
  ? data.entry.data.description ?? title
  : zh ? "用照片记录所见，用数据记录训练。" : "Capturing what I see through photos, and tracking training through data.";
const photo = data.kind === "record" ? data.entry.data.images[0] : undefined;
const languageAlternatives = data.kind === "index" && !data.year && data.page === 1
  ? [{ locale: "zh" as const, href: "/life/" }, { locale: "en" as const, href: "/en/life/" }]
  : [];
const pageHref = (page: number) => data.kind === "index" ? (page === 1 ? data.basePath : `${data.basePath}page/${page}/`) : home;
const previous = data.kind === "index" && data.page > 1 ? pageHref(data.page - 1) : undefined;
const next = data.kind === "index" && data.page < data.pageCount ? pageHref(data.page + 1) : undefined;
const structuredData = data.kind === "record" ? {
  "@context": "https://schema.org", "@type": "BlogPosting",
  headline: title, description, datePublished: data.entry.data.publishedAt.toISOString(),
  dateModified: (data.entry.data.updatedAt ?? data.entry.data.publishedAt).toISOString(),
  author: { "@type": "Person", name: SITE.author, url: new URL(SITE.authorProfilePath, SITE.url).href },
  url: new URL(lifeHref(data.entry), SITE.url).href,
  image: data.entry.data.images.map((image) => new URL(image.src, SITE.url).href),
} : undefined;
---

<BaseLayout
  title={title} description={description} locale={locale}
  type={data.kind === "record" ? "article" : "website"}
  image={photo?.src} imageAlt={photo?.alt}
  noindex={data.kind === "index" && data.entries.length === 0}
  languageAlternatives={languageAlternatives}
  languageSwitcherAlternatives={[{ locale: "zh", href: "/life/" }, { locale: "en", href: "/en/life/" }]}
>
  {previous && <link slot="head" rel="prev" href={previous} />}
  {next && <link slot="head" rel="next" href={next} />}
  {structuredData && <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />}
  <div class="shell life-page">
    {data.kind === "index" ? (
      <>
        <LifeSectionHeader locale={locale} active="photography" />
        {data.years.length > 1 && (
          <nav class="life-years" aria-label={zh ? "按年份归档" : "Browse by year"}>
            <span>{zh ? "年份" : "Year"}</span>
            {data.years.map((year) => <a href={localizePath(locale, `/life/year/${year}/`)} aria-current={data.year === year ? "page" : undefined}>{year}</a>)}
          </nav>
        )}
        {data.year && <h2 class="life-page__filter-title">{data.year}</h2>}
        <div class="life-timeline" data-pagefind-ignore="all">
          {data.entries.map((entry) => <LifeRecord entry={entry} />)}
          {data.entries.length === 0 && <p class="life-empty">{zh ? "还没有摄影记录。" : "No photography entries yet."}</p>}
        </div>
        <Pagination currentPage={data.page} lastPage={data.pageCount} firstPageUrl={data.basePath}
          pageUrlPrefix={`${data.basePath}page/`} prevUrl={previous} nextUrl={next} locale={locale}
          ariaLabel={zh ? "生活记录分页" : "Life pagination"} />
      </>
    ) : (
      <>
        <a class="life-back" href={home}>← {zh ? "摄影" : "Photography"}</a>
        <div data-pagefind-body data-pagefind-filter="type:life">
          {!data.entry.data.title && <h1 class="life-page__untitled" data-pagefind-meta="title">{title}</h1>}
          <LifeRecord entry={data.entry} detail />
        </div>
        <ContentMediaViewer locale={locale} />
        <ContentReaction contentType="life" contentId={data.entry.id} language={locale} />
        <ContentComments language={locale} threadPath={lifeHref(data.entry)} />
      </>
    )}
  </div>
</BaseLayout>

<style>
  .life-page { padding-block: 1rem 5rem; }
  .life-timeline, .life-years, .life-page__filter-title { max-width: 44rem; }
  .life-years { margin-top: 1rem; gap: 0.5rem 1rem; font-size: 0.8rem; color: var(--muted); }
  .life-years a { text-decoration: none; }
  .life-years a[aria-current="page"] { color: var(--accent); text-decoration: underline; }
  .life-page__filter-title { font-size: 1rem; margin: 2rem 0 0; color: var(--muted); }
  .life-back { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
  .life-page__untitled { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .life-empty { padding-block: 3rem; color: var(--muted); }
</style>
