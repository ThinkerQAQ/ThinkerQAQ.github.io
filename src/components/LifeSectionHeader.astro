---
import { localizePath, type Locale } from "../config/i18n";
import { workoutMonthHref } from "../lib/workouts";

interface Props { locale: Locale; active: "photography" | "fitness"; }
const { locale, active } = Astro.props;
const zh = locale === "zh";
---
<header class="page-header collection-header">
  <h1 class="visually-hidden">{zh ? "生活" : "Life"}</h1>
  <p>{zh ? "用照片记录所见，用数据记录训练。" : "Capturing what I see through photos, and tracking training through data."}</p>
</header>
<nav class="life-section__tabs" aria-label={zh ? "生活分类" : "Life sections"}>
  <a href={localizePath(locale, "/life/")} aria-current={active === "photography" ? "page" : undefined}>
    {zh ? "摄影" : "Photography"}
  </a>
  <a href={workoutMonthHref(locale)} aria-current={active === "fitness" ? "page" : undefined}>
    {zh ? "健身" : "Fitness"}
  </a>
</nav>
<style>
  .life-section__tabs { display:flex; align-items:center; flex-wrap:wrap; gap:0.55rem; margin-bottom:1.3rem; }
  .life-section__tabs a { border:1px solid var(--border); border-radius:999px; padding:0.3rem 1rem; font-size:0.9rem; color:var(--text); text-decoration:none; }
  .life-section__tabs a[aria-current="page"] { background:var(--accent-soft); border-color:var(--accent); color:var(--accent); }
  .life-section__tabs a:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
</style>
