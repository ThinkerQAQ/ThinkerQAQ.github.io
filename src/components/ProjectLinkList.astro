---
import type { ProjectExternalLink } from "../lib/project-relations";

interface Props {
  entries: ProjectExternalLink[];
  label?: string;
}

const { entries, label = "GitHub" } = Astro.props;
---

<ol class="content-list">
  {entries.map((entry) => (
    <li>
      <div class="content-list-main">
        <a class="content-title" href={entry.url}>{entry.title}</a>
        {entry.description && <p>{entry.description}</p>}
      </div>
      <div class="content-meta">
        <span>{label}</span>
      </div>
    </li>
  ))}
</ol>
