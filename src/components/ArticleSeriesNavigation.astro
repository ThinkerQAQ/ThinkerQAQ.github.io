---
import { LOCALES } from "../config/i18n";
import type { ArticleSeriesNavigation } from "../lib/content";
import { articleHref } from "../lib/content";
import PreviousNextNavigation from "./PreviousNextNavigation.astro";

interface Props {
  navigation: ArticleSeriesNavigation;
}

const { navigation } = Astro.props;
const current = navigation.articles[navigation.currentIndex];
const locale = current?.data.language ?? "zh";
const ui = LOCALES[locale].ui;
---

<PreviousNextNavigation
  previous={navigation.previous && {
    href: articleHref(navigation.previous),
    title: navigation.previous.data.title,
  }}
  next={navigation.next && {
    href: articleHref(navigation.next),
    title: navigation.next.data.title,
  }}
  ariaLabel={ui.seriesNavigation}
  itemLabel=""
  previousLabel={ui.previousArticle}
  nextLabel={ui.nextArticle}
/>
