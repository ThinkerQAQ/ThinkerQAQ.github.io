---
import type { Locale } from "../config/i18n";
import { workoutCalendarCells, workoutDayCount, workoutDayHref, workoutMonthHref, workoutMonthName, type WorkoutSession } from "../lib/workouts";
interface Props { locale: Locale; month: string; months: string[]; sessions: WorkoutSession[]; }
const { locale, month, months, sessions } = Astro.props;
const zh = locale === "zh";
const weekdays = zh ? ["一", "二", "三", "四", "五", "六", "日"] : ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const cells = workoutCalendarCells(month);
const byDay = new Map<string, WorkoutSession[]>();
for (const session of sessions) {
  const date = session.data.date;
  byDay.set(date, [...(byDay.get(date) ?? []), session]);
}
const index = months.indexOf(month);
const newer = index > 0 ? months[index - 1] : undefined;
const older = index >= 0 && index < months.length - 1 ? months[index + 1] : undefined;
const total = (field: "volumeKg" | "durationMinutes" | "caloriesKcal") =>
  sessions.some((session) => session.data[field] === undefined) || sessions.length === 0
    ? undefined
    : sessions.reduce((sum, session) => sum + (session.data[field] ?? 0), 0);
const volume = total("volumeKg");
const duration = total("durationMinutes");
const calories = total("caloriesKcal");
const recent = [...byDay].sort((a, b) => b[0].localeCompare(a[0]));
const isDemo = sessions.some((session) => session.data.demo);
---

<section class="fitness-calendar">
  <header class="fitness-calendar__head">
    <div>
      <span class="fitness-eyebrow">{zh ? "训练历史" : "Training history"}</span>
      <h2>{workoutMonthName(month, locale)}</h2>
    </div>
    <div class="fitness-calendar__nav" aria-label={zh ? "切换月份" : "Change month"}>
      {older ? <a href={workoutMonthHref(locale, older)} aria-label={zh ? "上一个有记录的月份" : "Previous recorded month"}>←</a> : <span aria-disabled="true">←</span>}
      {newer ? <a href={workoutMonthHref(locale, newer)} aria-label={zh ? "下一个有记录的月份" : "Next recorded month"}>→</a> : <span aria-disabled="true">→</span>}
    </div>
  </header>
  {isDemo && <p class="fitness-demo">{zh ? "演示数据 · 尚未连接训记" : "Sample data · Not connected to Xunji"}</p>}
  <div class="fitness-stats">
    <div class="fitness-stat">
      <span>{zh ? "训练天数" : "Active days"}</span>
      <strong>{workoutDayCount(sessions)} <small>{zh ? "天" : "days"}</small></strong>
    </div>
    <div class="fitness-stat">
      <span>{zh ? "总训练容量" : "Total volume"}</span>
      <strong>{volume === undefined ? "—" : (volume / 1000).toLocaleString(locale === "zh" ? "zh-CN" : "en-US", { maximumFractionDigits: 1 })} {volume === undefined ? "" : <small>t</small>}</strong>
    </div>
    <div class="fitness-stat">
      <span>{zh ? "训练时长" : "Training time"}</span>
      <strong>{duration === undefined ? "—" : (duration / 60).toLocaleString(locale === "zh" ? "zh-CN" : "en-US", { maximumFractionDigits: 1 })} {duration === undefined ? "" : <small>h</small>}</strong>
    </div>
  </div>
  <div class="fitness-calendar__grid" role="group" aria-label={workoutMonthName(month, locale)}>
    {weekdays.map((weekday) => <span class="fitness-calendar__weekday">{weekday}</span>)}
    {cells.map((date) => {
      const trained = date ? byDay.get(date) : undefined;
      const title = trained?.map((session) => session.data.title).join(" · ") ?? "";
      return date ? (
        <div class="fitness-calendar__cell">
          {trained ? (
            <a class="fitness-calendar__day fitness-calendar__day--trained" href={workoutDayHref(locale, date)} aria-label={`${date} · ${title}`}>
              <span class="fitness-calendar__number">{Number(date.slice(-2))}</span>
              <span class="fitness-calendar__dot" aria-hidden="true"></span>
              <small>{title}</small>
            </a>
          ) : (
            <span class="fitness-calendar__day" aria-label={date}>
              <span class="fitness-calendar__number">{Number(date.slice(-2))}</span>
            </span>
          )}
        </div>
      ) : <div class="fitness-calendar__cell fitness-calendar__cell--empty" aria-hidden="true"></div>;
    })}
  </div>
  {recent.length ? (
    <div class="fitness-calendar__recent">
      <h3>{zh ? "本月训练" : "Sessions this month"} <span>{sessions.length}</span></h3>
      {recent.map(([date, daySessions]) => (
        <a class="fitness-session-link" href={workoutDayHref(locale, date)}>
          <time datetime={date}>{Number(date.slice(-2))} <small>{zh ? "日" : " " + month.slice(5)}</small></time>
          <span>{daySessions.map((session) => session.data.title).join(" · ")}</span>
          <span class="fitness-session-link__duration">{daySessions.every((session) => session.data.durationMinutes !== undefined) ? `${daySessions.reduce((sum, session) => sum + (session.data.durationMinutes ?? 0), 0)} ${zh ? "分钟" : "min"}` : "—"}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
      {calories !== undefined && <p class="fitness-calendar__note">{zh ? "本月记录热量" : "Recorded calories"}：{Math.round(calories).toLocaleString()} kcal</p>}
    </div>
  ) : <p class="fitness-calendar__empty">{zh ? "本月暂无训练记录。数据同步后会显示在这里。" : "No training sessions this month yet."}</p>}
</section>

<style>
  .fitness-calendar { min-width: 0; }
  .fitness-calendar__head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: 1.6rem 0 1.25rem; }
  .fitness-eyebrow { font-size: 0.8rem; color: var(--muted); }
  .fitness-calendar__head h2 { margin: 0.25rem 0 0; font-size: clamp(1.4rem, 4.3vw, 1.85rem); letter-spacing: -0.025em; }
  .fitness-calendar__nav { display: flex; align-items: center; gap: 0.55rem; }
  .fitness-calendar__nav a, .fitness-calendar__nav span { display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border: 1px solid var(--border); border-radius: 0.55rem; text-decoration: none; color: var(--text); }
  .fitness-calendar__nav [aria-disabled] { color: var(--muted); opacity: 0.35; }
  .fitness-demo { display: inline-block; margin: 0 0 1rem; padding: 0.3rem 0.6rem; border: 1px dashed var(--border); border-radius: 0.4rem; font-size: 0.8rem; color: var(--muted); }
  .fitness-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem; margin-bottom: 1.5rem; }
  .fitness-stat { display: flex; flex-direction: column; gap: 0.45rem; padding: 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 0.6rem; min-width: 0; }
  .fitness-stat > span { color: var(--muted); font-size: 0.8rem; }
  .fitness-stat strong { font-size: clamp(1.4rem, 4vw, 1.85rem); font-weight: 650; font-variant-numeric: tabular-nums; }
  .fitness-stat small { font-size: 0.72rem; color: var(--muted); font-weight: 400; }
  .fitness-calendar__grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border: 1px solid var(--border); border-radius: 0.65rem; overflow: hidden; }
  .fitness-calendar__weekday { padding: 0.75rem 0; background: var(--surface); text-align: center; color: var(--muted); font-size: 0.74rem; border-bottom: 1px solid var(--border); }
  .fitness-calendar__cell { min-width: 0; border-bottom: 1px solid var(--border); border-right: 1px solid var(--border); }
  .fitness-calendar__cell:nth-child(7n) { border-right: 0; }
  .fitness-calendar__day { min-height: 5.9rem; display: flex; align-items: flex-start; flex-direction: column; padding: 0.55rem; gap: 0.3rem; text-decoration: none; color: var(--muted); }
  .fitness-calendar__number { font-size: 0.9rem; font-variant-numeric: tabular-nums; color: var(--text); }
  .fitness-calendar__day--trained { color: var(--text); background: var(--accent-soft); transition: background 140ms ease; }
  .fitness-calendar__day--trained:hover { background: var(--surface); }
  .fitness-calendar__day--trained:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
  .fitness-calendar__dot { width: 0.35rem; height: 0.35rem; flex: none; border-radius: 50%; background: var(--accent); }
  .fitness-calendar__day small { color: var(--muted); font-size: 0.69rem; overflow: hidden; width: 100%; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
  .fitness-calendar__recent { margin-top: 2rem; }
  .fitness-calendar__recent h3 { margin: 0 0 0.7rem; font-size: 1.05rem; }
  .fitness-calendar__recent h3 span { margin-left: 0.25rem; font-weight: 400; color: var(--muted); font-size: 0.8rem; }
  .fitness-session-link { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) auto auto; gap: 1rem; align-items: center; border-bottom: 1px solid var(--border); padding: 0.9rem 0; text-decoration: none; }
  .fitness-session-link > span:nth-child(2) { overflow-wrap: anywhere; }
  .fitness-session-link time { font-weight: 650; font-variant-numeric: tabular-nums; }
  .fitness-session-link time small, .fitness-session-link__duration { color: var(--muted); font-size: 0.8rem; font-weight: 400; }
  .fitness-calendar__note, .fitness-calendar__empty { color: var(--muted); font-size: 0.85rem; }
  .fitness-calendar__empty { padding: 1.5rem 0; }
  @media (max-width: 520px) {
    .fitness-stats { gap: 0.4rem; }
    .fitness-stat { padding: 0.7rem; }
    .fitness-stat > span { font-size: 0.72rem; }
    .fitness-calendar__day { min-height: 4.6rem; padding: 0.4rem 0.25rem; }
    .fitness-calendar__number { font-size: 0.8rem; }
    .fitness-calendar__dot { width: 0.29rem; height: 0.29rem; }
    .fitness-calendar__day small { font-size: 0.58rem; }
    .fitness-session-link { gap: 0.5rem; grid-template-columns: 2.6rem minmax(0,1fr) auto; }
    .fitness-session-link > span:last-child { display: none; }
  }
</style>
