---
import type { Locale } from "../config/i18n";
import { workoutMonthHref, workoutMonthName, workoutYearHref, type WorkoutSummary } from "../lib/workouts";

interface Props {
  locale: Locale;
  month: string;
  annualYear?: string;
  summaries: WorkoutSummary[];
}

const { locale, month, annualYear, summaries } = Astro.props;
const zh = locale === "zh";
const selectedYear = annualYear ?? month.slice(0, 4);
const years = [...new Set(summaries.map((entry) => entry.data.month.slice(0, 4)))].sort().reverse();
const byMonth = new Map(summaries.map((entry) => [entry.data.month, entry]));
// Use one scale across all years, so the same height means the same training frequency.
const maxDays = Math.max(1, ...summaries.map((entry) => entry.data.trainingDays));
const monthNumber = (value: number) => String(value).padStart(2, "0");
---
<section class="workout-trend" aria-labelledby="workout-trend-title" data-fitness-trend>
  <header class="workout-trend__heading">
    <div>
      <h2 id="workout-trend-title">{zh ? "年度训练趋势" : "Annual training trend"}</h2>
      <p>{zh ? "每月训练天数" : "Training days per month"}</p>
    </div>
    {years.length > 1 && (
      <nav class="workout-trend__years" aria-label={zh ? "选择年份" : "Choose year"}>
        {years.map((year) => (
          <a
            data-workout-year={year}
            href={workoutYearHref(locale, year)}
            aria-current={year === selectedYear ? "true" : undefined}
          >{year}</a>
        ))}
      </nav>
    )}
  </header>
  {years.length ? years.map((year) => (
    <div
      class="workout-trend__panel"
      data-workout-chart-year={year}
      role="group"
      aria-label={zh ? `${year} 年每月训练天数` : `Monthly training days in ${year}`}
      hidden={year !== selectedYear}
    >
      <div class="workout-trend__scroll" role="region" tabindex="0" aria-label={zh ? `${year} 年趋势图，可横向滚动` : `${year} chart, scrollable horizontally`}>
        <div class="workout-trend__chart">
          {Array.from({ length: 12 }, (_, index) => {
            const itemMonth = `${year}-${monthNumber(index + 1)}`;
            const entry = byMonth.get(itemMonth);
            const content = (
              <>
                <strong>{entry ? entry.data.trainingDays : "—"}</strong>
                <span class="workout-trend__bar-wrap">
                  {entry && <span class="workout-trend__bar" style={`height: ${entry.data.trainingDays ? Math.max(3, entry.data.trainingDays / maxDays * 100) : 0}%`}></span>}
                </span>
                <span class="workout-trend__month">{index + 1}{zh ? "月" : ""}</span>
              </>
            );
            return entry ? (
              <a
                href={workoutMonthHref(locale, itemMonth)}
                class:list={["workout-trend__item", { "workout-trend__item--active": itemMonth === month && !annualYear }]}
                aria-label={`${workoutMonthName(itemMonth, locale)}: ${entry.data.trainingDays} ${zh ? "天" : "days"}`}
                aria-current={itemMonth === month && !annualYear ? "page" : undefined}
                title={`${workoutMonthName(itemMonth, locale)} · ${entry.data.trainingDays} ${zh ? "天" : "days"}`}
              >{content}</a>
            ) : (
              <span class="workout-trend__item workout-trend__item--missing" aria-label={zh ? `${year} 年 ${index + 1} 月暂无记录` : `No data for ${workoutMonthName(itemMonth, locale)}`}>
                {content}
              </span>
            );
          })}
        </div>
      </div>
    </div>
  )) : <p class="workout-trend__empty">{zh ? "暂无训练趋势数据。" : "No trend data yet."}</p>}
  {years.length > 0 && <p class="workout-trend__hint">{zh
    ? "点击年份查看全年汇总，点击柱状图中的月份查看月度详情。— 表示暂无记录。"
    : "Select a year for its annual totals, or a month in the chart for monthly details; — means no data."}</p>}
</section>


<style>
  .workout-trend { margin-block: 2.2rem 2.7rem; }
  .workout-trend__heading { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.85rem; margin-bottom:1.15rem; }
  .workout-trend__heading h2 { margin:0; font-size:1.12rem; letter-spacing:-0.02em; }
  .workout-trend__heading p { margin:0.35rem 0 0; font-size:0.78rem; color:var(--muted); }
  .workout-trend__years { display:flex; flex-wrap:wrap; align-items:center; gap:0.35rem; }
  .workout-trend__years a { padding:0.35rem 0.7rem; border:1px solid var(--border); border-radius:0.5rem; color:var(--muted); font-size:0.82rem; text-decoration:none; font-variant-numeric:tabular-nums; }
  .workout-trend__years a[aria-current="true"] { border-color:var(--accent); background:var(--accent-soft); color:var(--accent); font-weight:600; }
  .workout-trend__years a:hover { color:var(--text); }
  .workout-trend__panel[hidden] { display:none; }
  .workout-trend__scroll { overflow-x:auto; padding-bottom:0.8rem; border-bottom:1px solid var(--border); }
  .workout-trend__chart { display:grid; grid-template-columns:repeat(12,minmax(2.4rem,1fr)); align-items:end; gap:0.65rem; min-width:32rem; height:12.1rem; }
  .workout-trend__item { display:flex; min-width:0; height:100%; flex-direction:column; justify-content:end; align-items:center; gap:0.32rem; color:var(--muted); text-decoration:none; }
  .workout-trend__item strong { font-size:0.82rem; font-weight:600; font-variant-numeric:tabular-nums; color:var(--text); }
  .workout-trend__bar-wrap { display:flex; align-items:end; justify-content:center; width:100%; height:8.1rem; }
  .workout-trend__bar { display:block; background:var(--border); border-radius:0.3rem 0.3rem 0 0; width:100%; max-width:2.3rem; min-height:0.15rem; transition:background 120ms ease; }
  .workout-trend__item:hover .workout-trend__bar { background:var(--muted); }
  .workout-trend__item--active .workout-trend__bar { background:var(--accent); }
  .workout-trend__month { color:var(--text); font-size:0.76rem; font-variant-numeric:tabular-nums; }
  .workout-trend__item--missing strong,.workout-trend__item--missing .workout-trend__month { color:var(--muted); opacity:0.55; }
  .workout-trend__hint,.workout-trend__empty { font-size:0.78rem; color:var(--muted); margin:0.85rem 0; }
  @media(max-width:520px) { .workout-trend__chart { gap:0.45rem; } }
</style>
