---
interface NavigationItem {
  href: string;
  title: string;
  current: boolean;
}

interface NavigationGroup {
  label?: string;
  href?: string;
  current?: boolean;
  items: NavigationItem[];
  children?: NavigationGroup[];
}

interface Props {
  group: NavigationGroup;
  depth?: number;
}

const { group, depth = 0 } = Astro.props;
const children = group.children ?? [];
---

<li class="mobile-reading-nav__group" data-navigation-depth={depth}>
  {group.label && (
    group.href ? (
      <a
        class="mobile-reading-nav__group-label"
        href={group.href}
        aria-current={group.current ? "page" : undefined}
      >{group.label}</a>
    ) : (
      <p class="mobile-reading-nav__group-label">{group.label}</p>
    )
  )}
  {group.items.length > 0 && (
    <ol class="mobile-reading-nav__items">
      {group.items.map((item) => (
        <li>
          <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.title}</a>
        </li>
      ))}
    </ol>
  )}
  {children.length > 0 && (
    <ol class="mobile-reading-nav__children">
      {children.map((child) => <Astro.self group={child} depth={depth + 1} />)}
    </ol>
  )}
</li>
