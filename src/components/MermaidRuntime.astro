<script is:inline type="module">
  const diagrams = [...document.querySelectorAll("pre.mermaid")];

  if (diagrams.length > 0) {
    try {
      const { default: mermaid } = await import(
        "https://cdn.jsdelivr.net/npm/mermaid@12.0.0/dist/mermaid.esm.min.mjs"
      );

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
      });

      for (const diagram of diagrams) {
        try {
          await mermaid.run({ nodes: [diagram] });

          // Mermaid sets data-processed while rendering. The media viewer must
          // wait until mermaid.run() has fully finished, otherwise Mermaid can
          // replace the viewer toolbar when it commits the final SVG.
          diagram.dataset.mermaidReady = "true";
          diagram.dispatchEvent(new CustomEvent("blog:mermaid-rendered", {
            bubbles: true,
          }));
        } catch (error) {
          diagram.dataset.mermaidFailed = "true";
          console.error("[mermaid] failed to render diagram", error);
        }
      }
    } catch (error) {
      for (const diagram of diagrams) {
        diagram.dataset.mermaidFailed = "true";
      }
      console.error("[mermaid] failed to load renderer", error);
    }
  }
</script>
