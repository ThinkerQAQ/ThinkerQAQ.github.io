---
interface RelatedItem {
  href: string;
  title: string;
  description?: string;
}

interface Props {
  headingId: string;
  title: string;
  items: RelatedItem[];
}

const { headingId, title, items } = Astro.props;
---

{items.length > 0 && (
  <section
    class="related-content"
    aria-labelledby={headingId}
    data-pagefind-ignore="all"
  >
    <div class="section-heading">
      <h2 id={headingId}>{title}</h2>
    </div>
    <ol class="content-list">
      {items.map((item) => (
        <li>
          <div class="content-list-main">
            <a class="content-title" href={item.href}>{item.title}</a>
            {item.description && <p>{item.description}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
