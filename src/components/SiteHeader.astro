---
import { DEFAULT_LOCALE, LOCALES, localizePath, type Locale, type LocaleAlternative } from "../config/i18n";
import { SITE } from "../config/site";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale?: Locale;
  languageAlternatives?: LocaleAlternative[];
}

const {
  locale = DEFAULT_LOCALE,
  languageAlternatives = [],
} = Astro.props;
const localeInfo = LOCALES[locale];
const pathname = Astro.url.pathname;
const homeHref = localizePath(locale, "/");
const navItems = [
  { href: localizePath(locale, "/articles/"), label: localeInfo.nav.articles },
  { href: localizePath(locale, "/projects/"), label: localeInfo.nav.projects },
  { href: localizePath(locale, "/series/"), label: localeInfo.nav.series },
  { href: localizePath(locale, "/notes/"), label: localeInfo.nav.notes },
  { href: localizePath(locale, "/about/"), label: localeInfo.nav.about },
] as const;
const searchHref = localizePath(locale, "/search/");
const articlesHref = localizePath(locale, "/articles/");
const isActive = (href: string) =>
  (href === articlesHref && pathname === homeHref) || pathname.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="site-name" href={homeHref} aria-label={localeInfo.ui.homeAriaLabel}>
      <img class="site-avatar" src="/avatar.svg" alt="" width="32" height="32" />
      <span>{SITE.title}</span>
    </a>
    <div class="header-actions">
      <nav class="main-nav" aria-label={localeInfo.ui.homeAriaLabel}>
        {navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))}
        <a href={searchHref} aria-current={isActive(searchHref) ? "page" : undefined}>
          {localeInfo.nav.search}
        </a>
      </nav>
      <LanguageSwitcher currentLocale={locale} alternatives={languageAlternatives} />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");

  if (header) {
    const syncHeaderHeight = () => {
      document.documentElement.style.setProperty("--site-header-height", `${header.offsetHeight}px`);
    };

    syncHeaderHeight();
    new ResizeObserver(syncHeaderHeight).observe(header);
  }
</script>

<style>
  .header-actions {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 720px) {
    .header-actions {
      gap: 0.7rem;
    }
  }
</style>
