---
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../config/i18n";
import type { NoteEntry, NoteTopicGroup } from "../lib/content";
import { categoryHref } from "../lib/content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentList from "./ContentList.astro";
import NoteTopicIndex from "./NoteTopicIndex.astro";
import Pagination from "./Pagination.astro";

interface Props {
  category: string;
  label: string;
  entries: NoteEntry[];
  topics?: NoteTopicGroup[];
  total: number;
  currentPage: number;
  lastPage: number;
  locale?: Locale;
}

const {
  category,
  label,
  entries,
  topics = [],
  total,
  currentPage,
  lastPage,
} = Astro.props;
const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const ui = LOCALES[locale].ui;
const firstPageUrl = categoryHref(category, locale);
const pageUrlPrefix = `${firstPageUrl}page/`;
const currentUrl = currentPage === 1 ? firstPageUrl : `${pageUrlPrefix}${currentPage}/`;
const prevUrl = currentPage > 1
  ? currentPage === 2 ? firstPageUrl : `${pageUrlPrefix}${currentPage - 1}/`
  : undefined;
const nextUrl = currentPage < lastPage ? `${pageUrlPrefix}${currentPage + 1}/` : undefined;
const pageTitle = currentPage === 1 ? label : `${label} · ${ui.pageLabel(currentPage)}`;
const description = locale === "en"
  ? `Learning notes grouped under ${label}. Note content is currently maintained in Chinese.`
  : `${label}主题下的技术学习笔记。`;
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={currentUrl}
  noindex={entries.length === 0 || locale !== DEFAULT_LOCALE}
  locale={locale}
>
  {prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}

  <NoteTopicIndex
    category={category}
    categoryLabel={label}
    topics={topics}
    total={total}
    locale={locale}
  >
    <header class="page-header detail-page-header">
      <h1>{label}</h1>
      <p>{ui.notesCount(total)}</p>
      {locale === "en" && <p class="note-description">{ui.notesChineseNotice}</p>}
    </header>

    <ContentList entries={entries} showCategory={false} showTopic={true} locale={locale} />
    <Pagination
      currentPage={currentPage}
      lastPage={lastPage}
      firstPageUrl={firstPageUrl}
      pageUrlPrefix={pageUrlPrefix}
      ariaLabel={`${label} ${ui.notesTitle}`}
      nextUrl={nextUrl}
      prevUrl={prevUrl}
      locale={locale}
    />
  </NoteTopicIndex>
</BaseLayout>
