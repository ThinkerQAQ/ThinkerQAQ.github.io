---
import { DEFAULT_LOCALE, LOCALES, localizePath, type Locale } from "../config/i18n";
import { SITE } from "../config/site";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const localeInfo = LOCALES[locale];
const contactHref = localizePath(locale, "/contact/");
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <span class="footer-copyright">© {new Date().getFullYear()} {SITE.author}</span>
    <div class="footer-registration">
      <a href={SITE.icpLookupUrl} target="_blank" rel="noopener noreferrer">{SITE.icpRecord}</a>
      <a href={SITE.publicSecurityLookupUrl} target="_blank" rel="noopener noreferrer">
        <img src="/gongan-beian.png" alt="" width="18" height="20" />
        {SITE.publicSecurityRecord}
      </a>
    </div>
    <nav class="footer-links" aria-label={locale === "en" ? "Footer links" : "页脚链接"}>
      <a href={locale === "en" ? "/en/rss.xml" : "/rss.xml"}>RSS</a>
      <a href={SITE.repository} target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>Source</span>
      </a>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.4 6.2-1.5 6.2-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6S17.7 1.2 15 3a13 13 0 0 0-7 0C5.3 1.2 4.2 1.5 4.2 1.5a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 2.7 8.7c0 5.2 3.2 6.3 6.2 6.7A3.4 3.4 0 0 0 8 18.1V22"></path>
        </svg>
        <span>GitHub</span>
      </a>
      <a href={contactHref}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 6L2 7"></path>
        </svg>
        <span>{localeInfo.nav.contact}</span>
      </a>
    </nav>
  </div>
</footer>
