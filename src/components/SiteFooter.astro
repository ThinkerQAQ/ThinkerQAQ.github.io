---
import { DEFAULT_LOCALE, LOCALES, localizePath, type Locale } from "../config/i18n";
import { SITE } from "../config/site";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const localeInfo = LOCALES[locale];
const contactHref = localizePath(locale, "/contact/");
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <span>© {new Date().getFullYear()} {SITE.author}</span>
    <span class="footer-links">
      <a href="/rss.xml">RSS</a>
      <a href={SITE.repository}>Source</a>
      <a href={contactHref}>{localeInfo.nav.contact}</a>
    </span>
  </div>
</footer>
