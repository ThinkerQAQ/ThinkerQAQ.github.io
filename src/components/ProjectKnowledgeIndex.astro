---
import type { Locale } from "../config/i18n";
import ArticleList from "./ArticleList.astro";
import {
  localizedSeriesSummary,
  seriesHref,
  seriesStatusLabel,
  type ArticleEntry,
  type ProjectEntry,
  type SeriesEntry,
} from "../lib/content";
import { buildProjectKnowledge } from "../lib/project-relations";

interface Props {
  project: ProjectEntry;
  articles: ArticleEntry[];
  seriesEntries: SeriesEntry[];
  locale: Locale;
}

const { project, articles, seriesEntries, locale } = Astro.props;
const knowledge = buildProjectKnowledge(project, locale, articles, seriesEntries);
const ui = locale === "en"
  ? {
      articles: "Articles",
      series: "Related Series",
      untranslatedArticle: "Chinese",
    }
  : {
      articles: "文章",
      series: "相关系列",
      untranslatedArticle: undefined,
    };
---

{knowledge.articles.length > 0 && (
  <section class="related-content" aria-labelledby="project-articles-heading">
    <h2 id="project-articles-heading">{ui.articles}</h2>
    <ArticleList
      entries={knowledge.articles}
      locale={locale}
      languageFallbackLabel={ui.untranslatedArticle}
    />
  </section>
)}

{knowledge.series.length > 0 && (
  <section class="related-content" aria-labelledby="project-series-heading">
    <h2 id="project-series-heading">{ui.series}</h2>
    <ol class="content-list">
      {knowledge.series.map((series) => {
        const summary = localizedSeriesSummary(series, locale);
        return (
          <li>
            <div class="content-list-main">
              <a class="content-title" href={seriesHref(series, locale)}>{summary.title}</a>
              <p>{summary.description}</p>
            </div>
            <div class="content-meta">
              <span>{seriesStatusLabel(series.data.status, locale)}</span>
            </div>
          </li>
        );
      })}
    </ol>
  </section>
)}
