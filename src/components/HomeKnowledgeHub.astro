---
import { getCollection } from "astro:content";
import { localizePath, type Locale } from "../config/i18n";
import {
  articleIsIncluded,
  categoryHref,
  formatDate,
  groupByCategory,
  localizedProjectSummary,
  localizedProjectTags,
  localizedSeriesSummary,
  noteHref,
  projectHref,
  projectStatusLabel,
  seriesHref,
  seriesStatusLabel,
  sortArticles,
  sortProjects,
  sortSeries,
} from "../lib/content";
import { localizeNoteMetadata, noteTranslationFor } from "../lib/note-i18n";
import { selectRecentNotes } from "../lib/recent-notes.mjs";
import LifeRecord from "./LifeRecord.astro";
import { getLifeEntries } from "../lib/life";
import ArticleList from "./ArticleList.astro";
import ShowcaseList from "./ShowcaseList.astro";

interface Props {
  locale: Locale;
}

interface KnowledgeDefinition {
  category: string;
  zh: string;
  en: string;
}

const { locale } = Astro.props;
const latestLife = (await getLifeEntries(locale)).slice(0, 1);

const copy = locale === "en"
  ? {
      topics: "Backend Engineering · Concurrency · Distributed Systems",
      description:
        "Notes on backend engineering, concurrency, distributed systems, data systems, and software engineering practice.",
      startTitle: "Start Here",
      allSeries: "All Series",
      latestTitle: "Latest Articles",
      allArticles: "All Articles",
      engineeringTitle: "Engineering Knowledge",
      recentNotesTitle: "Recent Notes",
      allNotes: "All Notes",
      beyondTitle: "Beyond Engineering",
      projectsTitle: "Projects",
      allProjects: "All Projects",
      notesCount: (count: number) => `${count} ${count === 1 ? "note" : "notes"}`,
      articlesCount: (count: number) => `${count} ${count === 1 ? "article" : "articles"}`,
      relatedScope: (count: number) => `${count} related note ${count === 1 ? "area" : "areas"}`,
    }
  : {
      topics: "后端工程 · 并发编程 · 分布式系统",
      description: "记录后端工程、并发编程、分布式系统与数据系统中的实践与思考。",
      startTitle: "从这里开始",
      allSeries: "全部系列",
      latestTitle: "最新文章",
      allArticles: "全部文章",
      engineeringTitle: "技术知识",
      recentNotesTitle: "最近笔记",
      allNotes: "全部笔记",
      beyondTitle: "工程之外",
      projectsTitle: "项目",
      allProjects: "全部项目",
      notesCount: (count: number) => `${count} 篇笔记`,
      articlesCount: (count: number) => `${count} 篇文章`,
      relatedScope: (count: number) => `${count} 个关联笔记主题`,
    };

const engineeringDefinitions: KnowledgeDefinition[] = [
  { category: "ai", zh: "AI", en: "AI" },
  { category: "distributed-systems", zh: "分布式系统", en: "Distributed Systems" },
  { category: "computer-architecture-assembly", zh: "计算机体系结构与汇编", en: "Computer Architecture & Assembly" },
  { category: "java", zh: "Java / JVM", en: "Java / JVM" },
  { category: "database", zh: "数据库", en: "Databases" },
  { category: "message-queue", zh: "消息队列", en: "Message Queues" },
  { category: "operating-system", zh: "操作系统", en: "Operating Systems" },
];

const beyondDefinitions: KnowledgeDefinition[] = [
  { category: "photography", zh: "摄影", en: "Photography" },
  { category: "investing", zh: "投资", en: "Investing" },
  { category: "economics", zh: "经济学", en: "Economics" },
  { category: "fitness", zh: "健身", en: "Fitness" },
];

const [allArticles, allSeries, allNotes, allNoteTranslations, allProjects] = await Promise.all([
  getCollection("articles"),
  getCollection("series"),
  getCollection("notes"),
  getCollection("noteTranslations"),
  getCollection("projects"),
]);

const publishedArticles = sortArticles(allArticles.filter(articleIsIncluded));
const latestArticles = publishedArticles
  .filter((article) => article.data.language === locale)
  .slice(0, 5);

const localizedSeries = sortSeries(allSeries).filter((series) =>
  locale === "en" ? Boolean(series.data.translations?.en) : true,
);
const featuredSeries = localizedSeries.filter((series) => series.data.featured);
const activeSeries = localizedSeries.filter((series) => series.data.status === "active");
const startSeries = [...featuredSeries, ...activeSeries, ...localizedSeries]
  .filter((series, index, candidates) =>
    candidates.findIndex((candidate) => candidate.id === series.id) === index,
  )
  .slice(0, 2);

function seriesArticleCount(series: (typeof allSeries)[number]): number {
  if (locale === "zh") {
    return series.data.relatedArticles.filter((rootId) =>
      publishedArticles.some(
        (article) => article.id === rootId && article.data.language === "zh",
      ),
    ).length;
  }

  return series.data.relatedArticles.filter((rootId) =>
    publishedArticles.some(
      (article) => article.data.translationOf === rootId && article.data.language === locale,
    ),
  ).length;
}

const seriesItems = startSeries.map((series) => {
  const summary = localizedSeriesSummary(series, locale);
  const articleCount = seriesArticleCount(series);
  const relatedScopeCount = series.data.relatedNoteCategories.length + series.data.relatedNoteScopes.length;
  const firstScopeLabel = series.data.relatedNoteScopes[0]?.label;
  const labelParts = [copy.articlesCount(articleCount)];
  if (firstScopeLabel && relatedScopeCount === 1) labelParts.push(firstScopeLabel);
  else if (relatedScopeCount > 0) labelParts.push(copy.relatedScope(relatedScopeCount));

  return {
    href: seriesHref(series, locale),
    title: summary.title,
    description: summary.description,
    label: labelParts.join(" · "),
    status: seriesStatusLabel(series.data.status, locale),
  };
});

const publicNoteGroups = new Map(
  groupByCategory(allNotes.filter((note) => note.data.indexable))
    .map((group) => [group.category, group] as const),
);

function resolveKnowledge(definitions: KnowledgeDefinition[], minimumNotes = 1) {
  return definitions.flatMap((definition) => {
    const group = publicNoteGroups.get(definition.category);
    if (!group || group.entries.length < minimumNotes) return [];
    return [{
      category: definition.category,
      label: locale === "en" ? definition.en : definition.zh,
      count: group.entries.length,
    }];
  });
}

const engineeringAreas = resolveKnowledge(engineeringDefinitions);
const beyondEngineeringAreas = resolveKnowledge(beyondDefinitions);

const categoryLabels = new Map(
  [...engineeringDefinitions, ...beyondDefinitions].map((definition) => [
    definition.category,
    locale === "en" ? definition.en : definition.zh,
  ]),
);
// Recent notes are cross-category, not a subset of engineering knowledge.
// English entries must have a translation; historical and non-indexable notes
// are excluded by selectRecentNotes and remain available in category archives.
const recentNotes = selectRecentNotes(
  allNotes
    .filter((note) => locale === "zh" || Boolean(noteTranslationFor(note, allNoteTranslations, locale)))
    .map((note) => localizeNoteMetadata(note, allNoteTranslations, locale)),
).map((note) => ({
  href: noteHref(note, locale),
  title: note.data.title,
  description: note.data.description,
  categoryLabel: categoryLabels.get(note.data.category) ?? note.data.categoryLabel,
  updatedAt: note.data.updatedAt,
}));

const localizedProjects = locale === "en"
  ? allProjects.filter((project) => Boolean(project.data.translations?.en))
  : allProjects;
const projects = sortProjects(localizedProjects).slice(0, 3);
const projectItems = projects.map((project) => {
  const summary = localizedProjectSummary(project, locale);
  return {
    href: projectHref(project, locale),
    title: summary.title,
    description: summary.description,
    label: localizedProjectTags(project, locale).join(" · "),
    status: projectStatusLabel(project.data.status, locale),
  };
});
---

<div class="shell home">
  <header class="home-hero">
    <h1>{copy.topics}</h1>
    <p class="home-hero__description">{copy.description}</p>
  </header>

  {seriesItems.length > 0 && (
    <section class="home-section" aria-labelledby="home-start-title">
      <div class="section-heading">
        <h2 id="home-start-title">{copy.startTitle}</h2>
        <a href={localizePath(locale, "/series/")}>{copy.allSeries} →</a>
      </div>
      <ShowcaseList items={seriesItems} />
    </section>
  )}

  {latestArticles.length > 0 && (
    <section class="home-section" aria-labelledby="home-latest-title">
      <div class="section-heading">
        <h2 id="home-latest-title">{copy.latestTitle}</h2>
        <a href={localizePath(locale, "/articles/")}>{copy.allArticles} →</a>
      </div>
      <ArticleList entries={latestArticles} locale={locale} />
    </section>
  )}

  {projectItems.length > 0 && (
    <section class="home-section" aria-labelledby="home-projects-title">
      <div class="section-heading">
        <h2 id="home-projects-title">{copy.projectsTitle}</h2>
        <a href={localizePath(locale, "/projects/")}>{copy.allProjects} →</a>
      </div>
      <ShowcaseList items={projectItems} />
    </section>
  )}

  {recentNotes.length > 0 && (
    <section class="home-section" aria-labelledby="home-recent-notes-title">
      <div class="section-heading">
        <h2 id="home-recent-notes-title">{copy.recentNotesTitle}</h2>
        <a href={localizePath(locale, "/notes/")}>{copy.allNotes} →</a>
      </div>
      <ol class="home-recent-notes">
        {recentNotes.map((note) => (
          <li>
            <div class="home-recent-notes__body">
              <a href={note.href}>{note.title}</a>
              <p>{note.description}</p>
            </div>
            <div class="home-recent-notes__meta">
              <span>{note.categoryLabel}</span>
              <time datetime={note.updatedAt.toISOString()}>{formatDate(note.updatedAt, locale)}</time>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  {engineeringAreas.length > 0 && (
    <section class="home-section" aria-labelledby="home-engineering-title">
      <div class="section-heading">
        <h2 id="home-engineering-title">{copy.engineeringTitle}</h2>
        <a href={localizePath(locale, "/notes/")}>{copy.allNotes} →</a>
      </div>
      <ul class="home-knowledge-grid">
        {engineeringAreas.map((area) => (
          <li>
            <a href={categoryHref(area.category, locale)}>
              <span>{area.label}</span>
              <small>{copy.notesCount(area.count)}</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {beyondEngineeringAreas.length > 0 && (
    <section class="home-section" aria-labelledby="home-beyond-title">
      <div class="section-heading">
        <h2 id="home-beyond-title">{copy.beyondTitle}</h2>
        <a href={localizePath(locale, "/notes/")}>{copy.allNotes} →</a>
      </div>
      <ul class="home-knowledge-grid">
        {beyondEngineeringAreas.map((area) => (
          <li>
            <a href={categoryHref(area.category, locale)}>
              <span>{area.label}</span>
              <small>{copy.notesCount(area.count)}</small>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {latestLife.length > 0 && (
    <section class="home-section" aria-labelledby="home-life-title">
      <div class="section-heading">
        <h2 id="home-life-title">{locale === "zh" ? "最近生活" : "Recent Life"}</h2>
        <a href={localizePath(locale, "/life/")}>{locale === "zh" ? "全部生活" : "All Life"} →</a>
      </div>
      <div class="home-life-records" data-pagefind-ignore="all">
        {latestLife.map((entry) => <LifeRecord entry={entry} />)}
      </div>
    </section>
  )}

</div>

<style>
  .home-life-records { border-top: 1px solid var(--border); }
  .home-life-records > :global(.life-record) { max-width: 40rem; }
  .home {
    padding-block: clamp(2.5rem, 5vw, 4rem) 7rem;
  }

  .home-hero {
    max-width: 48rem;
  }

  .home-hero h1 {
    margin: 0;
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: 720;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .home-hero__description {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .home-hero + .home-section {
    margin-top: 3.25rem;
  }

  .home-recent-notes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-recent-notes > li {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .home-recent-notes__body {
    min-width: 0;
  }

  .home-recent-notes__body a {
    font-weight: 650;
    text-decoration: none;
  }

  .home-recent-notes__body p {
    display: -webkit-box;
    overflow: hidden;
    max-width: 48rem;
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.65;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .home-recent-notes__meta {
    display: flex;
    flex: none;
    align-items: baseline;
    gap: 1rem;
    color: var(--faint);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .home-knowledge-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 4rem;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .home-knowledge-grid li {
    min-width: 0;
    border-bottom: 1px solid var(--border);
  }

  .home-knowledge-grid a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    text-decoration: none;
  }

  .home-knowledge-grid a > span {
    min-width: 0;
    font-weight: 650;
  }

  .home-knowledge-grid small {
    flex: none;
    color: var(--faint);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  @media (max-width: 680px) {
    .home {
      padding-block: 2.25rem 4.5rem;
    }

    .home-hero h1 {
      font-size: clamp(1.5rem, 7vw, 1.9rem);
    }

    .home-hero + .home-section {
      margin-top: 2.75rem;
    }

    .home-recent-notes > li {
      gap: 0.65rem;
      flex-direction: column;
    }

    .home-recent-notes__meta {
      gap: 0.75rem;
    }

    .home-knowledge-grid {
      grid-template-columns: 1fr;
      column-gap: 0;
    }
  }
</style>
