---
import { ASK_BLOG_UI } from "../config/i18n-features";
import {
  DEFAULT_LOCALE,
  LOCALES,
  SUPPORTED_LOCALES,
  type Locale,
} from "../config/i18n";

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const copy = ASK_BLOG_UI[locale];
const workerEndpoint = import.meta.env.PUBLIC_ASK_BLOG_WORKER_URL ?? "";
const turnstileSiteKey = import.meta.env.PUBLIC_ASK_BLOG_TURNSTILE_SITE_KEY ?? "";
const nonDefaultLocalePaths = SUPPORTED_LOCALES
  .filter((candidate) => candidate !== DEFAULT_LOCALE)
  .map((candidate) => LOCALES[candidate].path)
  .filter(Boolean);
const serializedCopy = JSON.stringify(copy).replaceAll("<", "\\u003c");
---

<div
  class="ask-blog"
  data-ask-blog
  data-endpoint={workerEndpoint}
  data-turnstile-sitekey={turnstileSiteKey}
  data-locale={locale}
  data-non-default-locales={JSON.stringify(nonDefaultLocalePaths)}
>
  <script is:inline type="application/json" data-ask-copy set:html={serializedCopy}></script>
  <button class="ask-blog__trigger" type="button" aria-expanded="false" aria-controls="ask-blog-panel" data-ask-toggle>
    <span aria-hidden="true">✦</span><span>Ask</span>
  </button>

  <section class="ask-blog__panel" id="ask-blog-panel" role="dialog" aria-labelledby="ask-blog-title" hidden data-ask-panel>
    <header class="ask-blog__header">
      <div>
        <h2 id="ask-blog-title">{copy.title}</h2>
        <p>{copy.description}</p>
      </div>
      <div class="ask-blog__header-actions">
        <button class="ask-blog__clear" type="button" hidden data-ask-clear>{copy.clear}</button>
        <button class="ask-blog__close" type="button" aria-label={copy.closeLabel} data-ask-close>×</button>
      </div>
    </header>

    <div class="ask-blog__conversation" data-ask-conversation aria-live="polite"></div>

    <form class="ask-blog__form" data-ask-form>
      <label for="ask-blog-question">{copy.questionLabel}</label>
      <textarea
        id="ask-blog-question"
        name="question"
        rows="2"
        maxlength="1000"
        placeholder={copy.placeholder}
        required
        data-ask-input
      ></textarea>
      <div class="ask-blog__turnstile" data-turnstile-container aria-label={copy.securityLabel}></div>
      <div class="ask-blog__actions">
        <p class="ask-blog__status" role="status" data-ask-status></p>
        <button type="submit" data-ask-submit>{copy.submit}</button>
      </div>
    </form>
  </section>
</div>

<script>
  const root = document.querySelector("[data-ask-blog]");
  const toggle = root?.querySelector("[data-ask-toggle]");

  if (root && toggle) {
    let controllerPromise;
    let loading = false;

    const loadController = () => {
      controllerPromise ??= import("../lib/ask-blog-runtime.js")
        .then(({ initAskBlog }) => initAskBlog(root))
        .catch((error) => {
          controllerPromise = undefined;
          throw error;
        });
      return controllerPromise;
    };

    toggle.addEventListener("click", async () => {
      if (loading) return;
      loading = true;
      try {
        const controller = await loadController();
        controller?.toggle();
      } catch (error) {
        console.error("Failed to load Ask this blog", error);
      } finally {
        loading = false;
      }
    });
  }
</script>

<style>
  .ask-blog {
    position: fixed;
    right: var(--floating-action-edge);
    bottom: calc(var(--floating-action-edge) + var(--floating-footer-offset));
    z-index: 30;
    transition: bottom 140ms ease;
  }
  .ask-blog button, .ask-blog textarea { font: inherit; }
  .ask-blog__trigger { display: inline-flex; align-items: center; gap: .45rem; padding: .68rem .9rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--text); box-shadow: var(--shadow); cursor: pointer; font-size: .86rem; font-weight: 700; }
  .ask-blog__trigger:hover, .ask-blog__trigger:focus-visible { border-color: var(--accent); color: var(--accent); }
  .ask-blog__panel { position: absolute; right: 0; bottom: calc(100% + var(--floating-action-stack-gap)); display: flex; flex-direction: column; width: min(32rem, calc(100vw - 2rem)); max-height: min(46rem, calc(100vh - var(--floating-footer-offset) - 6rem)); overflow: hidden; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); box-shadow: 0 18px 60px rgba(0,0,0,.14); }
  .ask-blog__panel[hidden] { display: none; }
  .ask-blog__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1rem; border-bottom: 1px solid var(--border); }
  .ask-blog__header h2, .ask-blog__header p, .ask-blog__sources h3, .ask-blog__status { margin: 0; }
  .ask-blog__header h2 { font-size: 1rem; }
  .ask-blog__header p { margin-top: .2rem; color: var(--muted); font-size: .78rem; }
  .ask-blog__header-actions { display: flex; align-items: center; gap: .25rem; }
  .ask-blog__clear, .ask-blog__close { border: 0; background: transparent; color: var(--muted); cursor: pointer; }
  .ask-blog__clear { padding: .35rem .45rem; border-radius: .4rem; font-size: .72rem; }
  .ask-blog__close { width: 2rem; height: 2rem; padding: 0; font-size: 1.35rem; line-height: 1; }
  .ask-blog__conversation { display: flex; flex: 1 1 auto; flex-direction: column; gap: .9rem; min-height: 8rem; max-height: 30rem; overflow-y: auto; padding: 1rem; scroll-behavior: smooth; }
  .ask-blog__empty { margin: auto 0; padding: 1rem; border: 1px dashed var(--border); border-radius: .7rem; color: var(--muted); font-size: .82rem; line-height: 1.65; }
  .ask-blog__message { max-width: 92%; }
  .ask-blog__message--user { align-self: flex-end; }
  .ask-blog__message--assistant { align-self: flex-start; width: 100%; }
  .ask-blog__message-label { margin-bottom: .3rem; color: var(--muted); font-size: .7rem; font-weight: 700; }
  .ask-blog__message--user .ask-blog__message-label { text-align: right; }
  .ask-blog__message-body { padding: .72rem .82rem; border: 1px solid var(--border); border-radius: .75rem; background: var(--background); color: var(--text); font-size: .88rem; line-height: 1.7; overflow-wrap: anywhere; }
  .ask-blog__message--user .ask-blog__message-body { background: color-mix(in srgb, var(--accent) 10%, var(--surface)); white-space: pre-wrap; }
  .ask-blog__message-body :global(p), .ask-blog__message-body :global(ul), .ask-blog__message-body :global(ol), .ask-blog__message-body :global(pre), .ask-blog__message-body :global(blockquote), .ask-blog__message-body :global(h3), .ask-blog__message-body :global(h4) { margin: .55rem 0 0; }
  .ask-blog__message-body :global(p:first-child), .ask-blog__message-body :global(h3:first-child), .ask-blog__message-body :global(h4:first-child), .ask-blog__message-body :global(pre:first-child) { margin-top: 0; }
  .ask-blog__message-body :global(ul), .ask-blog__message-body :global(ol) { padding-left: 1.25rem; }
  .ask-blog__message-body :global(code) { padding: .08rem .28rem; border-radius: .3rem; background: var(--surface); font-size: .86em; }
  .ask-blog__message-body :global(pre) { overflow-x: auto; padding: .7rem; border: 1px solid var(--border); border-radius: .55rem; background: var(--surface); }
  .ask-blog__message-body :global(pre code) { padding: 0; background: transparent; white-space: pre; }
  .ask-blog__message-body :global(blockquote) { padding-left: .75rem; border-left: 3px solid var(--border); color: var(--muted); }
  .ask-blog__message--pending { padding: .85rem; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); border-radius: .75rem; background: color-mix(in srgb, var(--accent) 5%, var(--background)); }
  .ask-blog__loading { display: flex; align-items: center; gap: .55rem; font-size: .86rem; }
  .ask-blog__loading-detail { display: block; margin: .35rem 0 .55rem 1.45rem; color: var(--muted); font-size: .72rem; }
  .ask-blog__spinner { width: .9rem; height: .9rem; flex: none; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: ask-blog-spin .8s linear infinite; }
  .ask-blog__progress { height: .22rem; overflow: hidden; border-radius: 999px; background: color-mix(in srgb, var(--border) 75%, transparent); }
  .ask-blog__progress span { display: block; width: 45%; height: 100%; border-radius: inherit; background: var(--accent); animation: ask-blog-progress 1.2s ease-in-out infinite; }
  .ask-blog__sources { margin-top: .55rem; padding-left: .1rem; }
  .ask-blog__sources h3 { color: var(--muted); font-size: .72rem; }
  .ask-blog__sources ol { margin: .4rem 0 0; padding-left: 1.35rem; color: var(--muted); font-size: .75rem; }
  .ask-blog__sources li + li { margin-top: .28rem; }
  .ask-blog__sources a { color: inherit; text-decoration: underline; text-underline-offset: .15em; }
  .ask-blog__source-type { display: inline-block; padding: .04rem .28rem; border: 1px solid var(--border); border-radius: .3rem; color: var(--muted); font-size: .66rem; }
  .ask-blog__form { display: grid; gap: .55rem; padding: .85rem 1rem 1rem; border-top: 1px solid var(--border); background: var(--surface); }
  .ask-blog__form label { font-size: .76rem; font-weight: 700; }
  .ask-blog__form textarea { width: 100%; min-height: 4.2rem; max-height: 10rem; resize: vertical; padding: .7rem; border: 1px solid var(--border); border-radius: .7rem; outline: none; background: var(--background); color: var(--text); line-height: 1.55; }
  .ask-blog__form textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 14%, transparent); }
  .ask-blog__turnstile:empty { display: none; }
  .ask-blog__actions { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .ask-blog__status { min-height: 1em; color: var(--muted); font-size: .74rem; }
  .ask-blog__status.is-error { color: #b42318; }
  .ask-blog__form button { flex: none; padding: .48rem .8rem; border: 1px solid var(--accent); border-radius: .55rem; background: var(--accent); color: var(--background); cursor: pointer; font-size: .82rem; font-weight: 700; }
  .ask-blog__form button:disabled { cursor: wait; opacity: .65; }
  @keyframes ask-blog-spin { to { transform: rotate(360deg); } }
  @keyframes ask-blog-progress { 0% { transform: translateX(-110%); } 50% { transform: translateX(125%); } 100% { transform: translateX(250%); } }
  @media (prefers-reduced-motion: reduce) {
    .ask-blog { transition: none; }
    .ask-blog__spinner, .ask-blog__progress span { animation: none; }
  }
  @media (max-width: 640px) {
    .ask-blog__panel { width: calc(100vw - 1.6rem); max-height: calc(100vh - var(--floating-footer-offset) - 5rem); }
    .ask-blog__conversation { max-height: none; }
  }
</style>