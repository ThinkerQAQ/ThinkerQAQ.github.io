---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkoutCalendar from "./WorkoutCalendar.astro";
import { localizePath, type Locale } from "../config/i18n";
import { workoutMonthHref, workoutMonthName, type WorkoutPageData } from "../lib/workouts";

interface Props { locale: Locale; data: WorkoutPageData; }
const { locale, data } = Astro.props;
const zh = locale === "zh";
const home = localizePath(locale, "/life/");
const title = data.kind === "month" ? (zh ? "健身记录" : "Training log") : (zh ? `${data.date} 训练` : `Workout · ${data.date}`);
const description = zh ? "训练月历、动作和每组训练数据。" : "Monthly training calendar, exercises and sets.";
const sessions = data.sessions;
const isDemo = sessions.some((session) => session.data.demo);
const duration = sessions.reduce((sum, session) => sum + (session.data.durationMinutes ?? 0), 0);
const volume = sessions.reduce((sum, session) => sum + (session.data.volumeKg ?? 0), 0);
const calories = sessions.reduce((sum, session) => sum + (session.data.caloriesKcal ?? 0), 0);
const recorded = (field: "durationMinutes" | "volumeKg" | "caloriesKcal") => sessions.length > 0 && sessions.every((s) => s.data[field] !== undefined);
const month = data.kind === "day" ? data.date.slice(0, 7) : data.month;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  languageAlternatives={data.kind === "month" && data.months.length === 0
    ? [{ locale: "zh", href: "/life/fitness/" }, { locale: "en", href: "/en/life/fitness/" }]
    : []}
  languageSwitcherAlternatives={[
    { locale: "zh", href: "/life/fitness/" },
    { locale: "en", href: "/en/life/fitness/" },
  ]}
>
  <div class="shell fitness-page">
    <nav class="fitness-breadcrumb" aria-label={zh ? "位置导航" : "Breadcrumb"}>
      <a href={home}>{zh ? "生活" : "Life"}</a>
      <span>/</span>
      {data.kind === "day" ? <><a href={workoutMonthHref(locale, month)}>{zh ? "健身" : "Fitness"}</a><span>/</span><span>{data.date}</span></>
        : <span>{zh ? "健身" : "Fitness"}</span>}
    </nav>
    <header class="fitness-hero">
      <div>
        <p class="fitness-hero__eyebrow">{zh ? "生活 · 健身" : "Life · Fitness"}</p>
        <h1>{data.kind === "month" ? (zh ? "训练日历" : "Training calendar") : (zh ? "训练详情" : "Workout details")}</h1>
        <p>{data.kind === "month"
          ? (zh ? "按月回看训练，点开日期查看动作与组数。" : "Browse your sessions by month. Select a date to see all sets.")
          : workoutMonthName(month, locale)}</p>
      </div>
      <a class="fitness-hero__back" href={data.kind === "day" ? workoutMonthHref(locale, month) : home}>← {data.kind === "day" ? (zh ? "返回月历" : "Back to calendar") : (zh ? "生活记录" : "Life timeline")}</a>
    </header>
    {data.kind === "month" ? (
      <WorkoutCalendar locale={locale} month={data.month} months={data.months} sessions={sessions} />
    ) : (
      <section class="fitness-detail" data-pagefind-body data-pagefind-filter="type:fitness">
        {isDemo && <p class="fitness-detail__demo">{zh ? "演示数据 · 非真实训记同步" : "Sample data · Not synchronized"}</p>}
        <div class="fitness-detail__date"><time datetime={data.date}>{data.date.replaceAll("-", ".")}</time></div>
        <h2>{sessions.map((session) => session.data.title).join(" · ")}</h2>
        <div class="fitness-detail__stats">
          <div><span>{zh ? "时长" : "Duration"}</span><strong>{recorded("durationMinutes") ? `${duration} ${zh ? "分钟" : "min"}` : "—"}</strong></div>
          <div><span>{zh ? "训练容量" : "Volume"}</span><strong>{recorded("volumeKg") ? `${volume.toLocaleString(locale === "zh" ? "zh-CN" : "en-US")} kg` : "—"}</strong></div>
          <div><span>{zh ? "消耗" : "Calories"}</span><strong>{recorded("caloriesKcal") ? `${calories.toLocaleString()} kcal` : "—"}</strong></div>
        </div>
        <div class="fitness-detail__exercises">
          {sessions.flatMap((session) => session.data.exercises).map((exercise, index) => {
            const completedSets = exercise.sets.filter((set) => set.completed);
            const top = exercise.sets.find((set) => set.weightKg !== undefined && set.reps !== undefined);
            const totalSets = completedSets.length;
            return (
              <details class="fitness-exercise" open={index === 0}>
                <summary>
                  <span class="fitness-exercise__index">{String(index + 1).padStart(2, "0")}</span>
                  <span class="fitness-exercise__intro">
                    <strong>{exercise.name}</strong>
                    <small>{zh ? `${totalSets} / ${exercise.sets.length} 组完成` : `${totalSets} / ${exercise.sets.length} sets complete`}{top ? ` · ${top.weightKg} kg × ${top.reps}` : ""}</small>
                  </span>
                  <span class="fitness-exercise__toggle" aria-hidden="true">⌄</span>
                </summary>
                <div class="fitness-exercise__body">
                  <table>
                    <thead><tr>
                      <th scope="col">{zh ? "组" : "Set"}</th>
                      <th scope="col">{zh ? "重量" : "Weight"}</th>
                      <th scope="col">{zh ? "次数" : "Reps"}</th>
                      <th scope="col">{zh ? "状态" : "Status"}</th>
                    </tr></thead>
                    <tbody>
                      {exercise.sets.map((set, i) => <tr>
                        <td>{i + 1}</td>
                        <td>{set.weightKg === undefined ? (zh ? "自重" : "Bodyweight") : `${set.weightKg} kg`}</td>
                        <td>{set.reps ?? "—"}</td>
                        <td><span class={set.completed ? "fitness-exercise__done" : "fitness-exercise__pending"}>{set.completed ? "✓" : "—"}</span></td>
                      </tr>)}
                    </tbody>
                  </table>
                  {exercise.restSeconds !== undefined && <p>{zh ? "组间休息" : "Rest between sets"} · {exercise.restSeconds} s</p>}
                </div>
              </details>
            );
          })}
        </div>
        <a class="fitness-detail__footer" href={workoutMonthHref(locale, month)}>← {zh ? "返回" : "Back to"} {workoutMonthName(month, locale)}</a>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .fitness-page { max-width: 58rem; padding-block: 2rem 5.5rem; }
  .fitness-breadcrumb { display: flex; align-items: center; gap: 0.6rem; font-size: 0.82rem; color: var(--muted); }
  .fitness-breadcrumb a { color: inherit; text-decoration: none; }
  .fitness-breadcrumb a:hover { color: var(--accent); }
  .fitness-hero { margin: 1.75rem 0 2rem; display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .fitness-hero__eyebrow { margin: 0 0 0.45rem; color: var(--muted); font-size: 0.76rem; letter-spacing: 0.05em; }
  .fitness-hero h1 { margin: 0; font-size: clamp(2rem, 5vw, 2.7rem); letter-spacing: -0.04em; }
  .fitness-hero p:not(.fitness-hero__eyebrow) { margin: 0.65rem 0 0; color: var(--muted); font-size: 0.91rem; }
  .fitness-hero__back { font-size: 0.85rem; text-decoration: none; color: var(--muted); }
  .fitness-detail { max-width: 48rem; }
  .fitness-detail__demo { padding: 0.4rem 0.7rem; display: inline-block; border: 1px dashed var(--border); border-radius: 0.35rem; color: var(--muted); font-size: 0.8rem; }
  .fitness-detail__date { color: var(--muted); margin-top: 1.3rem; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .fitness-detail h2 { font-size: clamp(1.45rem, 5vw, 2rem); margin: 0.55rem 0 1.5rem; }
  .fitness-detail__stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0.6rem; margin-bottom: 2.5rem; }
  .fitness-detail__stats > div { display: grid; gap: 0.4rem; padding: 1rem; border: 1px solid var(--border); border-radius: 0.55rem; background: var(--surface); }
  .fitness-detail__stats span { color: var(--muted); font-size: 0.78rem; }
  .fitness-detail__stats strong { font-size: clamp(0.95rem,3vw,1.2rem); font-variant-numeric: tabular-nums; }
  .fitness-exercise { border-bottom: 1px solid var(--border); }
  .fitness-exercise summary { display: flex; gap: 1rem; align-items: center; padding: 1.25rem 0; cursor: pointer; list-style: none; }
  .fitness-exercise summary::-webkit-details-marker { display: none; }
  .fitness-exercise__index { color: var(--muted); font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .fitness-exercise__intro { display: grid; flex: 1; min-width: 0; gap: 0.4rem; }
  .fitness-exercise__intro strong { font-size: 1.02rem; }
  .fitness-exercise__intro small { color: var(--muted); font-size: 0.81rem; }
  .fitness-exercise__toggle { color: var(--muted); font-size: 1.3rem; transform: rotate(0deg); transition: transform 160ms; }
  .fitness-exercise[open] .fitness-exercise__toggle { transform: rotate(180deg); }
  .fitness-exercise__body { padding: 0 0 1.2rem 2.5rem; }
  .fitness-exercise__body table { border-collapse: collapse; width: 100%; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .fitness-exercise__body th { font-size: 0.74rem; text-align: left; font-weight: 500; color: var(--muted); padding: 0.65rem 0.4rem; border-bottom: 1px solid var(--border); }
  .fitness-exercise__body td { padding: 0.65rem 0.4rem; border-bottom: 1px solid var(--border); }
  .fitness-exercise__body th:last-child, .fitness-exercise__body td:last-child { text-align: right; }
  .fitness-exercise__done { color: var(--accent); font-weight: 700; }
  .fitness-exercise__pending { color: var(--muted); }
  .fitness-exercise__body p { font-size: 0.78rem; margin: 0.75rem 0 0; color: var(--muted); }
  .fitness-detail__footer { display: inline-block; text-decoration: none; margin-top: 2.5rem; color: var(--muted); font-size: 0.88rem; }
  @media(max-width:520px) {
    .fitness-page { padding-top: 1.5rem; }
    .fitness-hero { margin-block: 1.2rem 1.5rem; }
    .fitness-detail__stats { gap: 0.35rem; }
    .fitness-detail__stats > div { padding: 0.7rem 0.55rem; }
    .fitness-exercise summary { gap: 0.6rem; }
    .fitness-exercise__body { padding-left: 1.4rem; }
  }
</style>
