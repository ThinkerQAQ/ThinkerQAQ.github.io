---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkoutTrend from "./WorkoutTrend.astro";
import LifeSectionHeader from "./LifeSectionHeader.astro";
import ContentReaction from "./ContentReaction.astro";
import ContentComments from "./ContentComments.astro";
import type { Locale } from "../config/i18n";
import { workoutMonthHref, workoutMonthName, type WorkoutOverview } from "../lib/workouts";

interface Props { locale: Locale; data: WorkoutOverview; }
const { locale, data } = Astro.props;
const zh = locale === "zh";
const { summary, summaries, month } = data;
const title = zh ? "健身记录" : "Fitness log";
const description = zh ? "记录长期训练习惯：月度汇总与年度趋势。" : "A public overview of long-term fitness consistency, with monthly totals and annual trends.";
const index = summaries.findIndex((entry) => entry.data.month === month);
const prev = summaries[index + 1]?.data.month;
const next = index > 0 ? summaries[index - 1]?.data.month : undefined;
const duration = summary?.data.durationMinutes;
const volume = summary?.data.volumeKg;
const publishedDemo = summaries.some((entry) => entry.data.demo);
const localizedThisMonth = workoutMonthName(month, locale);
const languageAlternatives = [
  { locale: "zh" as const, href: summary ? workoutMonthHref("zh", month) : workoutMonthHref("zh") },
  { locale: "en" as const, href: summary ? workoutMonthHref("en", month) : workoutMonthHref("en") },
];
---
<BaseLayout
  title={summary ? `${localizedThisMonth} · ${title}` : title}
  description={description}
  locale={locale}
  noindex={!summaries.length}
  languageAlternatives={languageAlternatives}
  languageSwitcherAlternatives={languageAlternatives}
>
  <div class="shell fitness-page">
    <LifeSectionHeader locale={locale} active="fitness" />

    <div class="fitness-content">
    <section class="fitness-month" aria-labelledby="fitness-month-title" data-pagefind-body data-pagefind-filter="type:fitness">
      <div class="fitness-month__head">
        <div><span class="fitness-eyebrow">{zh ? "月度概览" : "Monthly summary"}</span><h2 id="fitness-month-title">{localizedThisMonth}</h2></div>
        <div class="fitness-month__nav" aria-label={zh ? "切换月份" : "Change month"}>
          {prev ? <a href={workoutMonthHref(locale, prev)} aria-label={zh ? "上一有记录月份" : "Previous recorded month"}>←</a> : <span aria-disabled="true">←</span>}
          {next ? <a href={workoutMonthHref(locale, next)} aria-label={zh ? "下一有记录月份" : "Next recorded month"}>→</a> : <span aria-disabled="true">→</span>}
        </div>
      </div>
      <div class="fitness-stats">
        <div><span>{zh ? "训练天数" : "Training days"}</span><strong>{summary ? summary.data.trainingDays : "—"}{summary && <small>{zh ? "天" : "days"}</small>}</strong></div>
        <div><span>{zh ? "训练时长" : "Training time"}</span><strong>{duration === undefined ? "—" : (duration / 60).toLocaleString(zh ? "zh-CN" : "en-US", {maximumFractionDigits: 1})}{duration !== undefined && <small>h</small>}</strong></div>
        <div><span>{zh ? "训练容量" : "Training volume"}</span><strong>{volume === undefined ? "—" : (volume / 1000).toLocaleString(zh ? "zh-CN" : "en-US", {maximumFractionDigits: 1})}{volume !== undefined && <small>t</small>}</strong></div>
      </div>
      {!summary && <p class="fitness-empty">{zh ? "尚无公开的月度汇总。同步后将在这里显示。" : "No published monthly summary yet."}</p>}
      <p class="fitness-unit-note">{zh ? "训练容量是器械记录的重量与次数汇总，只供观察自身长期变化。" : "Training volume sums recorded weight and repetitions; it is useful for personal trends, not cross-exercise comparisons."}{publishedDemo && <> {zh ? "当前为模拟统计，未接入训记。" : "Currently showing sample totals, not connected to Xunji."}</>}</p>
    </section>

    <WorkoutTrend locale={locale} month={month} summaries={summaries} />

    {summary && (
      <section class="fitness-feedback" aria-label={zh ? "互动" : "Feedback"}>
        <ContentReaction contentType="fitness" contentId={month} language={locale} />
        <ContentComments language={locale} threadPath={workoutMonthHref("zh", month)} />
      </section>
    )}
    </div>
  </div>
</BaseLayout>
<style>
  .fitness-page { padding-block: 1rem 5rem; min-width:0; }
  .fitness-content { max-width: 56rem; min-width:0; }
  .fitness-feedback { margin-block: 3.5rem 0; }
  .fitness-month__head { display:flex; justify-content:space-between; align-items:end; gap:0.9rem; margin:0.7rem 0 1rem; }
  .fitness-month__head h2 { margin:0.2rem 0 0; font-size:clamp(1.35rem,4vw,1.7rem); letter-spacing:-0.025em; }
  .fitness-eyebrow { font-size:0.79rem; color:var(--muted); }
  .fitness-month__nav { display:flex; gap:0.5rem; }
  .fitness-month__nav a,.fitness-month__nav span { width:2.2rem; height:2.2rem; display:grid; place-items:center; border:1px solid var(--border); border-radius:0.55rem; color:var(--text); text-decoration:none; }
  .fitness-month__nav [aria-disabled] { opacity:0.35; }
  .fitness-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0.75rem; }
  .fitness-stats > div { display:flex; flex-direction:column; gap:0.6rem; min-width:0; padding:1rem; border:1px solid var(--border); border-radius:0.6rem; background:var(--surface); }
  .fitness-stats > div > span { font-size:0.82rem; color:var(--muted); }
  .fitness-stats strong { font-size:clamp(1.4rem,4vw,1.85rem); letter-spacing:-0.02em; font-variant-numeric:tabular-nums; }
  .fitness-stats small { margin-left:0.3rem; font-size:0.73rem; font-weight:400; letter-spacing:0; color:var(--muted); }
  .fitness-unit-note,.fitness-empty { margin:0.9rem 0; font-size:0.78rem; color:var(--muted); line-height:1.7; }
  @media(max-width:540px) { .fitness-page { padding-top:1.5rem; } .fitness-stats { gap:0.4rem; } .fitness-stats > div { padding:0.7rem 0.6rem; } .fitness-stats > div > span { font-size:0.71rem; } }
</style>
