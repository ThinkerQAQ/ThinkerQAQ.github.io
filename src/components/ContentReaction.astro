---
import type { Locale } from "../config/i18n";

interface Props {
  contentType: "article" | "note";
  contentId: string;
  language?: Locale;
}

const { contentType, contentId, language = "zh" } = Astro.props;
const endpoint = String(import.meta.env.PUBLIC_REACTION_WORKER_URL ?? "").replace(/\/+$/, "");
const enabled = Boolean(endpoint);
const isChinese = language === "zh";
const label = isChinese ? "有帮助" : "Helpful";
const loadingLabel = isChinese ? "正在加载有帮助数量" : "Loading helpful count";
const errorLabel = isChinese ? "暂时无法记录，请稍后再试。" : "Unable to record this right now.";
---

{enabled && (
  <section
    class="content-reaction"
    data-pagefind-ignore
    data-content-reaction
    data-endpoint={endpoint}
    data-content-type={contentType}
    data-content-id={contentId}
    data-error-label={errorLabel}
    aria-label={isChinese ? "内容反馈" : "Article feedback"}
  >
    <button
      class="content-reaction__button"
      type="button"
      aria-pressed="false"
      aria-label={label}
      data-reaction-button
    >
      <svg class="content-reaction__icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M7.5 10.5V20H4.75A1.75 1.75 0 0 1 3 18.25v-6A1.75 1.75 0 0 1 4.75 10.5H7.5Zm0 0 4.38-6.57c.48-.72 1.62-.38 1.62.49v4.33h4.92c1.3 0 2.27 1.2 2 2.47l-1.5 7A2.25 2.25 0 0 1 16.72 20H7.5v-9.5Z" />
      </svg>
      <span>{label}</span>
      <span class="content-reaction__count" data-reaction-count hidden></span>
    </button>
    <span class="visually-hidden" role="status" aria-live="polite" data-reaction-status>{loadingLabel}</span>
  </section>
)}

<script>
  // @ts-nocheck
  (() => {
    const STORAGE_KEY = "thinkerqaq:reaction-visitor:v1";
    let memoryVisitorId = "";

    const randomVisitorId = () => {
      if (crypto.randomUUID) return crypto.randomUUID();
      const bytes = crypto.getRandomValues(new Uint8Array(16));
      return Array.from(bytes, (value) => value.toString(16).padStart(2, "0")).join("");
    };

    const getVisitorId = () => {
      if (memoryVisitorId) return memoryVisitorId;
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          memoryVisitorId = saved;
          return saved;
        }
        const created = randomVisitorId();
        localStorage.setItem(STORAGE_KEY, created);
        memoryVisitorId = created;
        return created;
      } catch {
        memoryVisitorId = randomVisitorId();
        return memoryVisitorId;
      }
    };

    const setState = (root, reacted, count) => {
      const button = root.querySelector("[data-reaction-button]");
      const countElement = root.querySelector("[data-reaction-count]");
      button.setAttribute("aria-pressed", String(Boolean(reacted)));
      root.classList.toggle("is-reacted", Boolean(reacted));

      const normalizedCount = Math.max(0, Number(count) || 0);
      countElement.textContent = normalizedCount > 0 ? String(normalizedCount) : "";
      countElement.hidden = normalizedCount === 0;

      root.dataset.reacted = String(Boolean(reacted));
      root.dataset.count = String(normalizedCount);
    };

    const playReactionAnimation = (button) => {
      if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
      button.classList.remove("is-popping");
      void button.offsetWidth;
      button.classList.add("is-popping");
      button.addEventListener("animationend", () => button.classList.remove("is-popping"), { once: true });
    };

    const request = async (root, method = "GET") => {
      const endpoint = root.dataset.endpoint;
      const contentType = root.dataset.contentType;
      const contentId = root.dataset.contentId;
      const url = new URL("/v1/reactions", `${endpoint}/`);
      url.searchParams.set("contentType", contentType);
      url.searchParams.set("contentId", contentId);

      const response = await fetch(url, {
        method,
        headers: {
          "x-reaction-visitor": getVisitorId(),
        },
      });

      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || `HTTP ${response.status}`);
      return body;
    };

    const initialize = async (root) => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const button = root.querySelector("[data-reaction-button]");
      const status = root.querySelector("[data-reaction-status]");
      const errorLabel = root.dataset.errorLabel || "Unable to record this right now.";

      button.disabled = true;
      try {
        const state = await request(root);
        setState(root, state.reacted, state.count);
        status.textContent = "";
      } catch {
        status.textContent = errorLabel;
      } finally {
        button.disabled = false;
      }

      button.addEventListener("click", async () => {
        if (button.disabled) return;

        const wasReacted = root.dataset.reacted === "true";
        const previousCount = Number(root.dataset.count || 0);
        const nextReacted = !wasReacted;
        const optimisticCount = Math.max(0, previousCount + (nextReacted ? 1 : -1));

        setState(root, nextReacted, optimisticCount);
        if (nextReacted) playReactionAnimation(button);
        button.disabled = true;
        status.textContent = "";

        try {
          const state = await request(root, nextReacted ? "PUT" : "DELETE");
          setState(root, state.reacted, state.count);
        } catch {
          setState(root, wasReacted, previousCount);
          status.textContent = errorLabel;
        } finally {
          button.disabled = false;
        }
      });
    };

    for (const root of document.querySelectorAll("[data-content-reaction]")) {
      initialize(root);
    }
  })();
</script>

<style>
  .content-reaction {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 3.25rem 0 1.25rem;
  }

  .content-reaction__button {
    position: relative;
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.75rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 1rem;
    font-weight: 680;
    line-height: 1;
    cursor: pointer;
    isolation: isolate;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .content-reaction__button::after {
    position: absolute;
    z-index: -1;
    inset: -0.35rem;
    border: 1px solid color-mix(in srgb, var(--accent) 48%, transparent);
    border-radius: inherit;
    content: "";
    opacity: 0;
    pointer-events: none;
    transform: scale(0.88);
  }

  .content-reaction__button:hover:not(:disabled),
  .content-reaction__button:focus-visible,
  .content-reaction.is-reacted .content-reaction__button {
    border-color: color-mix(in srgb, var(--accent) 58%, var(--border));
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: 0 0.45rem 1.25rem color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .content-reaction__button:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .content-reaction__button:hover:not(:disabled)::after {
    animation: reaction-ready-ring 900ms ease-out;
  }

  .content-reaction__button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .content-reaction__button:active:not(:disabled) {
    transform: translateY(0) scale(0.98);
  }

  .content-reaction__button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .content-reaction__icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transform-origin: 45% 78%;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .content-reaction__button:hover:not(:disabled) .content-reaction__icon,
  .content-reaction__button:focus-visible .content-reaction__icon {
    transform: translateY(-2px) rotate(-8deg) scale(1.1);
  }

  .content-reaction.is-reacted .content-reaction__button .content-reaction__icon {
    fill: currentColor;
  }

  .content-reaction__button.is-popping .content-reaction__icon {
    animation: reaction-thumb-pop 460ms cubic-bezier(0.2, 0.9, 0.3, 1.35);
  }

  .content-reaction__button.is-popping::after {
    animation: reaction-confirm-ring 460ms ease-out;
  }

  .content-reaction__count::before {
    content: "·";
    margin-right: 0.5rem;
    color: var(--faint);
  }

  @keyframes reaction-ready-ring {
    0% {
      opacity: 0;
      transform: scale(0.88);
    }
    35% {
      opacity: 0.45;
    }
    100% {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes reaction-confirm-ring {
    0% {
      opacity: 0.55;
      transform: scale(0.9);
    }
    100% {
      opacity: 0;
      transform: scale(1.16);
    }
  }

  @keyframes reaction-thumb-pop {
    0% {
      transform: translateY(-2px) rotate(-8deg) scale(1.1);
    }
    45% {
      transform: translateY(-6px) rotate(-14deg) scale(1.28);
    }
    72% {
      transform: translateY(1px) rotate(4deg) scale(0.96);
    }
    100% {
      transform: translateY(0) rotate(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .content-reaction__button,
    .content-reaction__icon {
      transition: none;
    }

    .content-reaction__button:hover:not(:disabled),
    .content-reaction__button:active:not(:disabled),
    .content-reaction__button:hover:not(:disabled) .content-reaction__icon,
    .content-reaction__button:focus-visible .content-reaction__icon {
      transform: none;
    }

    .content-reaction__button::after,
    .content-reaction__button.is-popping::after,
    .content-reaction__button.is-popping .content-reaction__icon {
      animation: none;
    }
  }
</style>
