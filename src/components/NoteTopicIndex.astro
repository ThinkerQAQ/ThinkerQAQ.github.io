---
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../config/i18n";
import type { NoteTopicGroup, NoteTopicTreeNode } from "../lib/content";
import { buildNoteTopicTree, categoryHref, noteHref, noteTopicHref } from "../lib/content";
import ContentCollectionIndex from "./ContentCollectionIndex.astro";
import MobileReadingNavigation from "./MobileReadingNavigation.astro";

interface Props {
  category: string;
  categoryLabel: string;
  topics: NoteTopicGroup[];
  total: number;
  currentTopicPath?: string[];
  locale?: Locale;
}

interface TopicNavigationGroup {
  label: string;
  href: string;
  current: boolean;
  items: Array<{ href: string; title: string; current: boolean }>;
  children: TopicNavigationGroup[];
}

const {
  category,
  categoryLabel,
  topics,
  total,
  currentTopicPath = [],
  locale = DEFAULT_LOCALE,
} = Astro.props;
const ui = LOCALES[locale].ui;
const navigableTopics = topics.filter((topic) => topic.path.length > 0);
const rootNotes = topics
  .filter((topic) => topic.path.length === 0)
  .flatMap((topic) => topic.notes);
const hasNavigation = navigableTopics.length > 0 || rootNotes.length > 0;
const currentPathKey = currentTopicPath.join("/");
const topicToGroup = (topic: NoteTopicTreeNode): TopicNavigationGroup => ({
  label: topic.label,
  href: noteTopicHref(category, topic.path, locale),
  current: topic.path.map((segment) => segment.id).join("/") === currentPathKey,
  items: topic.notes.map((note) => ({
    href: noteHref(note, locale),
    title: note.data.title,
    current: false,
  })),
  children: topic.children.map(topicToGroup),
});
const groups = [
  {
    items: [{
      href: categoryHref(category, locale),
      title: `${ui.all} · ${total}`,
      current: currentTopicPath.length === 0,
    }],
  },
  ...(rootNotes.length > 0 ? [{
    items: rootNotes.map((note) => ({
      href: noteHref(note, locale),
      title: note.data.title,
      current: false,
    })),
  }] : []),
  ...buildNoteTopicTree(navigableTopics).map(topicToGroup),
];
---

<div class:list={["shell", "content-shell", "note-topic-shell", { "note-topic-shell--without-topics": !hasNavigation }]}>
  {hasNavigation && (
    <MobileReadingNavigation
      collection={{ label: ui.noteTopics, title: categoryLabel, href: categoryHref(category, locale), groups }}
      collectionTabLabel={ui.noteOutline}
    />
  )}
  {hasNavigation && (
    <ContentCollectionIndex
      label={ui.noteTopics}
      title={categoryLabel}
      href={categoryHref(category, locale)}
      groups={groups}
      ariaLabel={`${categoryLabel} ${ui.noteTopics}`}
      hideLabel={ui.hideNoteTopics}
      restoreLabel={ui.restoreNoteTopics}
    />
  )}
  <div class="shell page detail-page">
    <slot />
  </div>
</div>

<style>
  .note-topic-shell {
    width: min(calc(100% - 2.5rem), 96rem);
    grid-template-columns: minmax(12rem, 16rem) minmax(0, var(--content-width));
    justify-content: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding-top: 1rem;
  }

  .note-topic-shell.series-index-collapsed,
  .note-topic-shell--without-topics {
    grid-template-columns: minmax(0, var(--content-width));
  }

  .note-topic-shell > .detail-page {
    width: auto;
    min-width: 0;
    margin-inline: 0;
    padding: 0;
  }

  @media (max-width: 1200px) {
    .note-topic-shell,
    .note-topic-shell.series-index-collapsed,
    .note-topic-shell--without-topics {
      width: min(calc(100% - 2.5rem), var(--content-width));
      grid-template-columns: minmax(0, var(--content-width));
      gap: 0;
    }
  }
</style>
