---
import { NOTE_VIEW_UI } from "../config/i18n-features";
import type { Locale } from "../config/i18n";

interface Props {
  defaultView?: "markdown" | "mindmap";
  locale: Locale;
  markdownSourceUrl: string;
}

const {
  defaultView = "markdown",
  locale,
  markdownSourceUrl,
} = Astro.props;
const ui = NOTE_VIEW_UI[locale];
---

<div
  class="note-view-switcher"
  data-note-view-switcher
  data-default-view={defaultView}
  data-active-view="markdown"
  data-markdown-source={markdownSourceUrl}
  data-loading-message={ui.loading}
  data-load-failed-message={ui.loadFailed}
  data-fullscreen-failed-message={ui.fullscreenFailed}
  data-zoom-in-label={ui.zoomIn}
  data-zoom-out-label={ui.zoomOut}
  data-fit-label={ui.fit}
  data-recurse-label={ui.recurse}
  data-reading-content
>
  <div
    class="note-view-switcher__toolbar"
    role="group"
    aria-label={ui.controlsLabel}
    data-note-view-controls
    data-pagefind-ignore="all"
    hidden
  >
    <button type="button" data-note-view="markdown" aria-label="Markdown" aria-pressed="true">{ui.markdown}</button>
    <button type="button" data-note-view="mindmap" aria-label={ui.mindmapLabel} aria-pressed="false">{ui.mindmap}</button>
  </div>
  <p
    class="note-view-switcher__status"
    role="status"
    aria-live="polite"
    data-note-view-status
    data-pagefind-ignore="all"
    hidden
  ></p>
  <div data-note-view-panel="markdown" data-note-markdown-panel>
    <slot />
  </div>
  <section
    class="note-view-switcher__mindmap"
    data-note-view-panel="mindmap"
    data-note-mindmap-panel
    data-pagefind-ignore="all"
    aria-label={ui.mindmapLabel}
    hidden
  >
    <div class="note-view-switcher__canvas">
      <svg class="note-view-switcher__svg markmap" role="img" aria-label={ui.mindmapLabel}></svg>
      <div
        class="note-view-switcher__mindmap-toolbar media-viewer-toolbar"
        role="toolbar"
        aria-label={ui.mindmapControlsLabel}
      >
        <div data-markmap-toolbar></div>
        <span class="note-view-switcher__mindmap-divider" aria-hidden="true"></span>
        <button
          type="button"
          class="media-viewer-control"
          data-mindmap-action="fullscreen"
          data-fullscreen-label={ui.fullscreen}
          data-exit-fullscreen-label={ui.exitFullscreen}
          aria-label={ui.fullscreen}
          title={ui.fullscreen}
        >⛶</button>
      </div>
    </div>
    <p class="note-view-switcher__hint">{ui.interactionHint}</p>
  </section>
</div>

<script>
  import "markmap-toolbar/dist/style.css";

  type View = "markdown" | "mindmap";
  type MarkmapInstance = InstanceType<typeof import("markmap-view")["Markmap"]>;

  const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));

  const initializeSwitcher = (root: HTMLElement) => {
    const toolbar = root.querySelector<HTMLElement>("[data-note-view-controls]");
    const markdownPanel = root.querySelector<HTMLElement>("[data-note-markdown-panel]");
    const mindmapPanel = root.querySelector<HTMLElement>("[data-note-mindmap-panel]");
    const svg = root.querySelector<SVGSVGElement>(".note-view-switcher__svg");
    const status = root.querySelector<HTMLElement>("[data-note-view-status]");
    const markmapToolbarContainer = root.querySelector<HTMLElement>("[data-markmap-toolbar]");
    const sourceUrl = root.dataset.markdownSource;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-note-view]")];
    const fullscreenButton = root.querySelector<HTMLButtonElement>('[data-mindmap-action="fullscreen"]');

    if (!toolbar || !markdownPanel || !mindmapPanel || !svg || !status || !markmapToolbarContainer || !sourceUrl || buttons.length !== 2 || !fullscreenButton) return;

    let activeView: View = "markdown";
    let requestedView: View = "markdown";
    let markdownPromise: Promise<string> | null = null;
    let modulesPromise: Promise<{
      Transformer: typeof import("markmap-lib")["Transformer"];
      Markmap: typeof import("markmap-view")["Markmap"];
      Toolbar: typeof import("markmap-toolbar")["Toolbar"];
    }> | null = null;
    let loadPromise: Promise<boolean> | null = null;
    let markmapInstance: MarkmapInstance | null = null;

    const setStatus = (message = "", kind?: "error") => {
      status.textContent = message;
      status.hidden = !message;
      if (kind) status.dataset.kind = kind;
      else delete status.dataset.kind;
    };

    const setActiveView = (view: View) => {
      activeView = view;
      root.dataset.activeView = view;
      markdownPanel.hidden = view !== "markdown";
      mindmapPanel.hidden = view !== "mindmap";
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.noteView === view));
      });
    };

    const fetchMarkdown = () => {
      if (!markdownPromise) {
        markdownPromise = fetch(sourceUrl, {
          headers: { Accept: "text/markdown" },
          cache: "force-cache",
        }).then(async (response) => {
          if (!response.ok) throw new Error(`Markdown source returned ${response.status}`);
          const markdown = await response.text();
          if (!markdown.trim()) throw new Error("Markdown source is empty");
          return markdown;
        }).catch((error) => {
          markdownPromise = null;
          throw error;
        });
      }
      return markdownPromise;
    };

    const loadMarkmapModules = () => {
      if (!modulesPromise) {
        modulesPromise = Promise.all([
          import("markmap-lib"),
          import("markmap-view"),
          import("markmap-toolbar"),
        ]).then(([lib, view, toolbarModule]) => ({
          Transformer: lib.Transformer,
          Markmap: view.Markmap,
          Toolbar: toolbarModule.Toolbar,
        }))
          .catch((error) => {
            modulesPromise = null;
            throw error;
          });
      }
      return modulesPromise;
    };

    const renderMindmap = async () => {
      setStatus(root.dataset.loadingMessage || "Loading mind map…");
      try {
        const [markdown, { Transformer, Markmap, Toolbar }] = await Promise.all([
          fetchMarkdown(),
          loadMarkmapModules(),
        ]);
        const transformer = new Transformer();
        // Notes are public content, but raw HTML must not become active inside SVG/foreignObject nodes.
        transformer.md.set({ html: false });
        const { root: tree } = transformer.transform(markdown);
        if (!tree || (!tree.content?.trim() && !tree.children?.length)) {
          throw new Error("Markdown did not produce a mind-map tree");
        }
        markmapInstance = Markmap.create(svg, {
          autoFit: false,
          duration: 0,
          embedGlobalCSS: true,
          initialExpandLevel: 2,
          maxWidth: 280,
          paddingX: 16,
          pan: true,
          zoom: true,
          scrollForPan: false,
          spacingHorizontal: 90,
          spacingVertical: 6,
        }, tree);

        const officialToolbar = Toolbar.create(markmapInstance);
        officialToolbar.showBrand = false;
        officialToolbar.registry.zoomIn.title = root.dataset.zoomInLabel || "Zoom in";
        officialToolbar.registry.zoomOut.title = root.dataset.zoomOutLabel || "Zoom out";
        officialToolbar.registry.fit.title = root.dataset.fitLabel || "Fit window size";
        officialToolbar.registry.recurse.title = root.dataset.recurseLabel || "Toggle recursively";
        officialToolbar.setItems(["zoomOut", "fit", "zoomIn", "recurse"]);
        // Upstream toolbar items are divs; add keyboard access without replacing their handlers.
        officialToolbar.el.querySelectorAll<HTMLElement>(".mm-toolbar-item").forEach((item) => {
          item.tabIndex = 0;
          item.setAttribute("role", "button");
          item.setAttribute("aria-label", item.title);
          item.addEventListener("keydown", (event) => {
            if (event.key !== "Enter" && event.key !== " ") return;
            event.preventDefault();
            item.click();
          });
        });
        markmapToolbarContainer.replaceChildren(officialToolbar.el);
        return true;
      } catch {
        markmapInstance?.destroy();
        markmapInstance = null;
        svg.replaceChildren();
        markmapToolbarContainer.replaceChildren();
        if (requestedView === "mindmap") {
          setStatus(root.dataset.loadFailedMessage || "Could not load the mind map.", "error");
        }
        return false;
      }
    };

    const fitMindmap = async () => {
      if (!markmapInstance) return;
      await nextFrame();
      await nextFrame();
      await markmapInstance.fit();
    };

    const updateFullscreenButton = () => {
      const isFullscreen = document.fullscreenElement === mindmapPanel;
      const label = isFullscreen
        ? fullscreenButton.dataset.exitFullscreenLabel
        : fullscreenButton.dataset.fullscreenLabel;
      if (!label) return;
      fullscreenButton.setAttribute("aria-label", label);
      fullscreenButton.title = label;
    };

    const toggleFullscreen = async () => {
      try {
        if (document.fullscreenElement === mindmapPanel) {
          await document.exitFullscreen();
        } else {
          await mindmapPanel.requestFullscreen();
        }
      } catch {
        setStatus(root.dataset.fullscreenFailedMessage || "Could not enter fullscreen mode.", "error");
      }
    };

    fullscreenButton.addEventListener("click", () => {
      void toggleFullscreen();
    });

    let wasMindmapFullscreen = false;
    document.addEventListener("fullscreenchange", () => {
      const isMindmapFullscreen = document.fullscreenElement === mindmapPanel;
      updateFullscreenButton();
      if (isMindmapFullscreen || wasMindmapFullscreen) void fitMindmap();
      wasMindmapFullscreen = isMindmapFullscreen;
    });

    const requestView = (view: View) => {
      requestedView = view;
      if (view === "markdown") {
        setActiveView("markdown");
        setStatus();
        return;
      }
      if (markmapInstance) {
        setActiveView("mindmap");
        setStatus();
        void fitMindmap();
        return;
      }
      if (loadPromise) return;

      loadPromise = renderMindmap().then(async (success) => {
        if (requestedView !== "mindmap") {
          setStatus();
          return success;
        }
        if (!success) {
          setActiveView("markdown");
          requestedView = "markdown";
          return false;
        }
        setActiveView("mindmap");
        setStatus();
        try {
          await fitMindmap();
        } catch {
          setActiveView("markdown");
          requestedView = "markdown";
          setStatus(root.dataset.loadFailedMessage || "Could not load the mind map.", "error");
          return false;
        }
        return true;
      }).finally(() => {
        loadPromise = null;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextView = button.dataset.noteView === "mindmap" ? "mindmap" : "markdown";
        if (nextView === activeView && nextView === requestedView) return;
        requestView(nextView);
        // A floating switch may be used far below the note's beginning.
        // Bring the selected view into sight instead of leaving the reader below a collapsed page.
        root.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          block: "start",
        });
      });
    });

    // TOC and mobile reading-navigation links point to Markdown heading IDs.
    // Switch back before allowing their native hash navigation to run.
    document.addEventListener("click", (event) => {
      if (activeView !== "mindmap" || !(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[href^="#"]');
      const hash = link?.getAttribute("href")?.slice(1);
      if (!link || !hash) return;
      let targetId = hash;
      try {
        targetId = decodeURIComponent(hash);
      } catch {
        // Keep the literal hash if it is not valid percent-encoding.
      }
      const heading = document.getElementById(targetId);
      if (!heading || !markdownPanel.contains(heading)) return;
      event.preventDefault();
      requestView("markdown");
      history.pushState(null, "", link.href);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        heading.scrollIntoView({ behavior: "smooth", block: "start" });
      }));
    });

    const askToggle = document.querySelector<HTMLElement>("[data-ask-toggle]");
    const syncFloatingControls = () => {
      const askOpen = askToggle?.getAttribute("aria-expanded") === "true";
      const mobileNavigationOpen = document.body.classList.contains("mobile-reading-nav-open");
      const mapFullscreen = document.fullscreenElement === mindmapPanel;
      toolbar.hidden = Boolean(askOpen || mobileNavigationOpen || mapFullscreen);
    };

    if (askToggle) {
      new MutationObserver(syncFloatingControls).observe(askToggle, {
        attributes: true,
        attributeFilter: ["aria-expanded"],
      });
    }
    new MutationObserver(syncFloatingControls).observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
    });
    document.addEventListener("fullscreenchange", syncFloatingControls);

    syncFloatingControls();
    if (root.dataset.defaultView === "mindmap") requestView("mindmap");
  };

  document.querySelectorAll<HTMLElement>("[data-note-view-switcher]").forEach(initializeSwitcher);
</script>

<style>
  .note-view-switcher {
    min-width: 0;
    scroll-margin-top: calc(var(--site-header-height, 4rem) + 1rem);
  }

  .note-view-switcher [hidden] {
    display: none !important;
  }

  .note-view-switcher__toolbar {
    position: fixed;
    z-index: 20;
    right: var(--floating-action-edge);
    bottom: calc(
      var(--floating-action-edge) +
      var(--floating-footer-offset) +
      var(--floating-action-jump-offset) +
      var(--floating-action-jump-size) +
      var(--floating-action-stack-gap)
    );
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0.22rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: bottom 140ms ease, border-color 160ms ease;
  }

  .note-view-switcher__toolbar button {
    min-height: 2.1rem;
    padding: 0.35rem 0.65rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  .note-view-switcher__toolbar button[aria-pressed="true"] {
    background: var(--text);
    color: var(--surface);
  }

  .note-view-switcher__toolbar button:hover:not([aria-pressed="true"]) {
    background: var(--accent-soft);
    color: var(--text);
  }

  .note-view-switcher__toolbar button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .note-view-switcher__status {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .note-view-switcher__status[data-kind="error"] {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .note-view-switcher__mindmap-toolbar {
    position: absolute;
    z-index: 4;
    top: 0.65rem;
    right: 0.65rem;
    margin: 0;
  }

  .note-view-switcher__canvas:hover .note-view-switcher__mindmap-toolbar,
  .note-view-switcher__canvas:focus-within .note-view-switcher__mindmap-toolbar {
    opacity: 1;
  }

  .note-view-switcher__mindmap-divider {
    width: 1px;
    height: 1.2rem;
    margin-inline: 0.1rem;
    background: var(--border);
  }

  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar) {
    gap: 0.2rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item) {
    display: grid;
    min-width: 2rem;
    height: 2rem;
    place-items: center;
    margin: 0;
    border-radius: 0.35rem;
    cursor: pointer;
  }

  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item > *) {
    min-width: 0;
    color: var(--text);
  }

  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item:hover),
  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item:focus-visible),
  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item.active) {
    background: var(--accent-soft);
  }

  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item:hover > *),
  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item:focus-visible > *),
  :global(.note-view-switcher__mindmap-toolbar .mm-toolbar-item.active > *) {
    color: var(--text);
  }

  .note-view-switcher__canvas {
    position: relative;
    width: 100%;
    height: clamp(360px, 72vh, 860px);
    min-height: 360px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: var(--surface);
  }

  .note-view-switcher__mindmap:fullscreen {
    box-sizing: border-box;
    width: 100vw;
    height: 100vh;
    padding: 1rem;
    overflow: auto;
    background: var(--surface);
  }

  .note-view-switcher__mindmap:fullscreen .note-view-switcher__canvas {
    height: calc(100vh - 7.5rem);
    min-height: 0;
  }

  .note-view-switcher__svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .note-view-switcher__hint {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .note-view-switcher__canvas {
      height: 65vh;
      min-height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .note-view-switcher__toolbar button {
      scroll-behavior: auto;
    }
  }
</style>
