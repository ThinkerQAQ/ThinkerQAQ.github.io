---
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../config/i18n";
import type { NoteEntry } from "../lib/content";
import { categoryHref, noteHref } from "../lib/content";

interface Props {
  category: string;
  label: string;
  entries: NoteEntry[];
  href?: string;
  locale?: Locale;
}

const {
  category,
  label,
  entries,
  locale = DEFAULT_LOCALE,
  href = categoryHref(category, locale),
} = Astro.props;
const ui = LOCALES[locale].ui;
const hasMore = entries.length > 5;
const previewLabel = hasMore ? ui.recentUpdates : ui.allNotes;
const [baseLabel, ...scopeSegments] = label.split(" · ");
const scopeLabel = scopeSegments.join(" · ");
---

<section>
  <div class="category-title">
    <h2><a href={href}>{label}</a></h2>
  </div>
  <p class="category-preview-label">{previewLabel}</p>
  <ul aria-label={`${label} ${previewLabel}`}>
    {entries.slice(0, 5).map((note) => (
      <li><a href={noteHref(note, locale)}>{note.data.title}</a></li>
    ))}
  </ul>
  {hasMore && (
    <a class="more-link category-more-link" href={href}>
      {locale === "en"
        ? `View all ${entries.length} notes in ${baseLabel}${scopeLabel ? ` (${scopeLabel})` : ""} →`
        : `查看 ${baseLabel} 的全部 ${entries.length} 篇笔记${scopeLabel && `（${scopeLabel}）`} →`}
    </a>
  )}
</section>
