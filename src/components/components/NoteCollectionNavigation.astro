---
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../config/i18n";
import type { NoteCollectionNavigation } from "../lib/content";
import { noteHref } from "../lib/content";
import PreviousNextNavigation from "./PreviousNextNavigation.astro";

interface Props {
  navigation: NoteCollectionNavigation;
  locale?: Locale;
}

const { navigation, locale = DEFAULT_LOCALE } = Astro.props;
const ui = LOCALES[locale].ui;
---

<PreviousNextNavigation
  previous={navigation.previous && {
    href: noteHref(navigation.previous, locale),
    title: navigation.previous.data.title,
  }}
  next={navigation.next && {
    href: noteHref(navigation.next, locale),
    title: navigation.next.data.title,
  }}
  ariaLabel={locale === "en" ? "Note collection navigation" : "笔记集导航"}
  itemLabel={locale === "en" ? " note" : "笔记"}
  previousLabel={ui.previousArticle}
  nextLabel={ui.nextArticle}
/>
