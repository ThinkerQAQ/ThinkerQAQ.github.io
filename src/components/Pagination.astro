---
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../config/i18n";

interface Props {
  currentPage: number;
  lastPage: number;
  firstPageUrl?: string;
  pageUrlPrefix?: string;
  ariaLabel?: string;
  nextUrl?: string;
  prevUrl?: string;
  locale?: Locale;
}

type PaginationItem =
  | { type: "page"; page: number }
  | { type: "ellipsis"; key: string };

const {
  currentPage,
  lastPage,
  firstPageUrl = "/articles/",
  pageUrlPrefix = "/articles/page/",
  ariaLabel,
  nextUrl,
  prevUrl,
  locale = DEFAULT_LOCALE,
} = Astro.props;
const ui = LOCALES[locale].ui;
const resolvedAriaLabel = ariaLabel ?? `${LOCALES[locale].nav.articles} pagination`;

function pageUrl(page: number): string {
  return page === 1 ? firstPageUrl : `${pageUrlPrefix}${page}/`;
}

function paginationItems(): PaginationItem[] {
  const visiblePages = [...new Set([1, currentPage - 1, currentPage, currentPage + 1, lastPage])]
    .filter((page) => page >= 1 && page <= lastPage)
    .sort((left, right) => left - right);

  const items: PaginationItem[] = [];
  for (const page of visiblePages) {
    const previousPage = items.at(-1);
    if (previousPage?.type === "page") {
      const gap = page - previousPage.page;
      if (gap === 2) items.push({ type: "page", page: page - 1 });
      if (gap > 2) items.push({ type: "ellipsis", key: `${previousPage.page}-${page}` });
    }
    items.push({ type: "page", page });
  }
  return items;
}

const items = paginationItems();
---

{lastPage > 1 && (
  <nav class="pagination" aria-label={resolvedAriaLabel}>
    {prevUrl ? (
      <a class="pagination-direction" href={prevUrl} rel="prev">← {ui.previousPage}</a>
    ) : (
      <span class="pagination-direction is-disabled" aria-disabled="true">← {ui.previousPage}</span>
    )}

    <ol class="pagination-pages">
      {items.map((item) => (
        <li>
          {item.type === "ellipsis" ? (
            <span class="pagination-ellipsis" aria-hidden="true">…</span>
          ) : item.page === currentPage ? (
            <span class="pagination-page is-current" aria-current="page">{item.page}</span>
          ) : (
            <a class="pagination-page" href={pageUrl(item.page)} aria-label={ui.pageLabel(item.page)}>
              {item.page}
            </a>
          )}
        </li>
      ))}
    </ol>

    {nextUrl ? (
      <a class="pagination-direction" href={nextUrl} rel="next">{ui.nextPage} →</a>
    ) : (
      <span class="pagination-direction is-disabled" aria-disabled="true">{ui.nextPage} →</span>
    )}
  </nav>
)}
