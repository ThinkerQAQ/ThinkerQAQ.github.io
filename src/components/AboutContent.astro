---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import CollectionHeader from "./CollectionHeader.astro";

interface Props { entry: CollectionEntry<"pages">; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<CollectionHeader title={entry.data.title} description={entry.data.description} />
<div class="prose about-content">
  <Content />
</div>

<style>
  .about-content > :is(p, ul) { max-width: var(--reading-width); }
</style>
