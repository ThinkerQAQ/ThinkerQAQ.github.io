---
import AskBlog from "../components/AskBlogSession.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  DEFAULT_LOCALE,
  LOCALES,
  languageAlternativesForPath,
  unlocalizePath,
  type Locale,
  type LocaleAlternative,
} from "../config/i18n";
import { SITE } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  canonicalPath?: string;
  language?: string;
  locale?: Locale;
  languageAlternatives?: LocaleAlternative[];
  languageSwitcherAlternatives?: LocaleAlternative[];
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  type = "website",
  canonicalPath = Astro.url.pathname,
  locale = DEFAULT_LOCALE,
  language = LOCALES[locale].htmlLang,
  languageAlternatives: providedLanguageAlternatives,
  languageSwitcherAlternatives: providedLanguageSwitcherAlternatives,
} = Astro.props;

// The language switcher answers "where can the reader browse this page in another
// site language?". hreflang answers the stricter SEO question "where is the true
// localized equivalent of this content?". Sparse translations mean those sets are
// not always identical.
const switchableShellPaths = new Set([
  "/",
  "/articles/",
  "/series/",
  "/projects/",
  "/notes/",
  "/about/",
  "/search/",
]);
const localizedSeoShellPaths = new Set([
  "/",
  "/articles/",
  "/series/",
  "/projects/",
  "/about/",
]);
const logicalPath = unlocalizePath(Astro.url.pathname);
const normalizedLogicalPath =
  logicalPath === "/" ? "/" : `${logicalPath.replace(/\/+$/, "")}/`;
const inferredLanguageAlternatives = localizedSeoShellPaths.has(normalizedLogicalPath)
  ? languageAlternativesForPath(normalizedLogicalPath)
  : [];
const inferredLanguageSwitcherAlternatives = switchableShellPaths.has(normalizedLogicalPath)
  ? languageAlternativesForPath(normalizedLogicalPath)
  : [];
const languageAlternatives = providedLanguageAlternatives ?? inferredLanguageAlternatives;
const languageSwitcherAlternatives = providedLanguageSwitcherAlternatives
  ?? providedLanguageAlternatives
  ?? inferredLanguageSwitcherAlternatives;
const pageTitle =
  title === SITE.title && normalizedLogicalPath === "/"
    ? LOCALES[locale].homeTitle
    : title === SITE.title
      ? title
      : `${title} · ${SITE.title}`;
const canonical = new URL(canonicalPath, SITE.url);
const defaultAlternative = languageAlternatives.find(
  (alternative) => alternative.locale === DEFAULT_LOCALE,
);
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
const umamiDomain = new URL(SITE.url).hostname;
const askBlogWorkerUrl = import.meta.env.PUBLIC_ASK_BLOG_WORKER_URL?.trim();
let umamiProxyOrigin = "";
if (askBlogWorkerUrl) {
  try {
    umamiProxyOrigin = new URL(askBlogWorkerUrl).origin;
  } catch {
    umamiProxyOrigin = "";
  }
}
const umamiScriptUrl = umamiProxyOrigin ? `${umamiProxyOrigin}/u.js` : "";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    {languageAlternatives.map((alternative) => (
      <link
        rel="alternate"
        hreflang={LOCALES[alternative.locale].htmlLang}
        href={new URL(alternative.href, SITE.url)}
      />
    ))}
    {defaultAlternative && (
      <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternative.href, SITE.url)} />
    )}
    <link rel="icon" href="/brand-mark.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={language.replace("-", "_")} />
    <meta name="twitter:card" content="summary" />
    {umamiWebsiteId && umamiProxyOrigin && (
      <script
        is:inline
        defer
        src={umamiScriptUrl}
        data-website-id={umamiWebsiteId}
        data-domains={umamiDomain}
        data-host-url={umamiProxyOrigin}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={noindex ? "all" : undefined}>
    <a class="skip-link" href="#main-content">{LOCALES[locale].ui.skipToContent}</a>
    <SiteHeader locale={locale} languageAlternatives={languageSwitcherAlternatives} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <AskBlog locale={locale} />
  </body>
</html>
