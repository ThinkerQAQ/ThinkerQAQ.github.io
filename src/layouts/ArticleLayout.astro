---
import type { CollectionEntry } from "astro:content";
import ArticleComments from "../components/ArticleComments.astro";
import ArticleSeriesIndex from "../components/ArticleSeriesIndex.astro";
import ArticleSeriesNavigation from "../components/ArticleSeriesNavigation.astro";
import MobileReadingNavigation from "../components/MobileReadingNavigation.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { SITE } from "../config/site";
import { articleHref, articleTagHref, formatDate, seriesHref, type ArticleSeriesNavigation as SeriesNavigation } from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: CollectionEntry<"articles">;
  headings: Heading[];
  translation?: CollectionEntry<"articles">;
  seriesNavigation?: SeriesNavigation;
}

const { article, headings, translation, seriesNavigation } = Astro.props;
const { data } = article;
const articlePath = `/articles/${article.id}/`;
const mobileCollection = seriesNavigation ? {
  label: "所属系列",
  title: seriesNavigation.series.data.title,
  href: seriesHref(seriesNavigation.series),
  groups: [{
    items: seriesNavigation.articles.map((entry, index) => ({
      href: articleHref(entry),
      title: entry.data.title,
      current: index === seriesNavigation.currentIndex,
    })),
  }],
} : undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { "@type": "Person", name: SITE.author },
  inLanguage: data.language === "en" ? "en" : "zh-CN",
  mainEntityOfPage: new URL(articlePath, SITE.url).toString(),
};
---

<BaseLayout title={data.title} description={data.description} type="article" canonicalPath={articlePath} language={schema.inLanguage} noindex={data.status === "draft"}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
  {translation && <link slot="head" rel="alternate" hreflang={schema.inLanguage} href={new URL(articlePath, SITE.url)} />}
  {translation && (
    <link
      slot="head"
      rel="alternate"
      hreflang={translation.data.language === "en" ? "en" : "zh-CN"}
      href={new URL(`/articles/${translation.id}/`, SITE.url)}
    />
  )}
  <div class:list={["shell", "content-shell", { "content-shell--with-series": seriesNavigation }]}>
    <MobileReadingNavigation collection={mobileCollection} collectionTabLabel="系列文章" headings={headings} />
    {seriesNavigation && <ArticleSeriesIndex navigation={seriesNavigation} />}
    <article class="note" data-pagefind-body>
      <header class="note-header">
        {data.status === "draft" && <p class="eyebrow">草稿预览</p>}
        <h1 data-pagefind-meta="title">{data.title}</h1>
        <p class="note-description">{data.description}</p>
        <div class="note-meta">
          <span data-pagefind-filter="language">{data.language === "en" ? "English" : "中文"}</span>
          <span>{data.status === "draft" ? "草稿日期" : "发布于"} <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></span>
          {data.updatedAt && <span>更新于 {formatDate(data.updatedAt)}</span>}
          {translation && <a href={`/articles/${translation.id}/`}>{translation.data.language === "en" ? "Read in English" : "阅读中文版"}</a>}
        </div>
        {data.tags.length > 0 && (
          <div class="tag-list" aria-label="标签">
            {data.tags.map((tag) => <a href={articleTagHref(tag)} rel="tag">{tag}</a>)}
          </div>
        )}
      </header>

      <div class="prose"><slot /></div>
      {seriesNavigation && (seriesNavigation.previous || seriesNavigation.next) && (
        <ArticleSeriesNavigation navigation={seriesNavigation} />
      )}
      {data.sourceNote && (
        <p class="source-note">本文迁移自<a href={data.sourceNote}>原始学习笔记</a>，文章版本独立维护。</p>
      )}
      <ArticleComments language={data.language} pathname={articlePath} />
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
