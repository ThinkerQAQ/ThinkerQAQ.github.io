---
import type { CollectionEntry } from "astro:content";
import ArticleComments from "../components/ArticleComments.astro";
import ArticleSeriesIndex from "../components/ArticleSeriesIndex.astro";
import ArticleSeriesNavigation from "../components/ArticleSeriesNavigation.astro";
import ContentReaction from "../components/ContentReaction.astro";
import MobileReadingNavigation from "../components/MobileReadingNavigation.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { LOCALES, type LocaleAlternative } from "../config/i18n";
import { SITE } from "../config/site";
import {
  articleHref,
  articleTagHref,
  formatDate,
  localizedSeriesSummary,
  seriesHref,
  type ArticleSeriesNavigation as SeriesNavigation,
} from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: CollectionEntry<"articles">;
  headings: Heading[];
  translations?: CollectionEntry<"articles">[];
  seriesNavigation?: SeriesNavigation;
}

const { article, headings, translations = [article], seriesNavigation } = Astro.props;
const { data } = article;
const locale = data.language;
const localeInfo = LOCALES[locale];
const articlePath = articleHref(article);
const languageAlternatives: LocaleAlternative[] = translations.map((entry) => ({
  locale: entry.data.language,
  href: articleHref(entry),
}));
const seriesSummary = seriesNavigation
  ? localizedSeriesSummary(seriesNavigation.series, locale)
  : undefined;
const mobileCollection = seriesNavigation && seriesSummary ? {
  label: localeInfo.ui.seriesLabel,
  title: seriesSummary.title,
  href: seriesHref(seriesNavigation.series, locale),
  groups: [{
    items: seriesNavigation.articles.map((entry, index) => ({
      href: articleHref(entry),
      title: entry.data.title,
      current: index === seriesNavigation.currentIndex,
    })),
  }],
} : undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { "@type": "Person", name: SITE.author },
  inLanguage: localeInfo.htmlLang,
  mainEntityOfPage: new URL(articlePath, SITE.url).toString(),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  canonicalPath={articlePath}
  language={localeInfo.htmlLang}
  locale={locale}
  languageAlternatives={languageAlternatives}
  noindex={data.status === "draft"}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
  <div class:list={["shell", "content-shell", { "content-shell--with-series": seriesNavigation }]}>
    <MobileReadingNavigation collection={mobileCollection} collectionTabLabel={localeInfo.ui.seriesLabel} headings={headings} />
    {seriesNavigation && <ArticleSeriesIndex navigation={seriesNavigation} />}
    <article class="note" data-pagefind-body>
      <header class="note-header">
        {data.status === "draft" && <p class="eyebrow">{localeInfo.ui.draftPreview}</p>}
        <h1 data-pagefind-meta="title">{data.title}</h1>
        <p class="note-description">{data.description}</p>
        <div class="note-meta">
          <span data-pagefind-filter="language">{localeInfo.label}</span>
          <span>
            {data.status === "draft" ? localeInfo.ui.draftDate : localeInfo.ui.publishedAt}
            {" "}<time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt, locale)}</time>
          </span>
          {data.updatedAt && <span>{localeInfo.ui.updatedAt} {formatDate(data.updatedAt, locale)}</span>}
        </div>
        {data.tags.length > 0 && (
          <div class="tag-list" aria-label={localeInfo.ui.tags}>
            {data.tags.map((tag) => <a href={articleTagHref(tag)} rel="tag">{tag}</a>)}
          </div>
        )}
      </header>

      <div class="prose"><slot /></div>
      {seriesNavigation && (seriesNavigation.previous || seriesNavigation.next) && (
        <ArticleSeriesNavigation navigation={seriesNavigation} />
      )}
      {data.sourceNote && (
        locale === "zh" ? (
          <p class="source-note">本文迁移自<a href={data.sourceNote}>原始学习笔记</a>，文章版本独立维护。</p>
        ) : (
          <p class="source-note">This article was migrated from the <a href={data.sourceNote}>original learning notes</a> and is maintained independently.</p>
        )
      )}
      <ContentReaction contentType="article" contentId={article.id} language={locale} />
      <ArticleComments language={locale} pathname={articlePath} />
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
