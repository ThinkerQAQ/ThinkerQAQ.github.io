---
import type { CollectionEntry } from "astro:content";
import ContentReaction from "../components/ContentReaction.astro";
import NoteCollectionIndex from "../components/NoteCollectionIndex.astro";
import NoteSequenceNavigation from "../components/NoteCollectionNavigation.astro";
import MobileReadingNavigation from "../components/MobileReadingNavigation.astro";
import ReadingExperience from "../components/ReadingExperience.astro";
import RelatedContent from "../components/RelatedContent.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { READING_EXPERIENCE_UI, RELATED_CONTENT_UI } from "../config/i18n-features";
import { DEFAULT_LOCALE, LOCALES, localizePath, type Locale } from "../config/i18n";
import { SITE } from "../config/site";
import { articleHref, categoryHref, formatDate, getNoteTopicPath, noteHref, noteTagHref, noteTopicHref, type NoteCollectionNavigation } from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  note: CollectionEntry<"notes">;
  headings: Heading[];
  collectionNavigation: NoteCollectionNavigation;
  readingMinutes: number;
  locale?: Locale;
  relatedArticles?: CollectionEntry<"articles">[];
}

const {
  note,
  headings,
  collectionNavigation,
  readingMinutes,
  relatedArticles = [],
} = Astro.props;
const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const { data } = note;
const ui = LOCALES[locale].ui;
const readingUi = READING_EXPERIENCE_UI[locale];
const relatedUi = RELATED_CONTENT_UI[locale];
const topicPath = getNoteTopicPath(note);
const notePath = noteHref(note, locale);
const canonicalPath = data.canonicalPath ?? (locale === DEFAULT_LOCALE ? notePath : noteHref(note, DEFAULT_LOCALE));
const mobileCollection = {
  label: ui.noteCollection,
  title: collectionNavigation.categoryLabel,
  href: categoryHref(collectionNavigation.category, locale),
  groups: collectionNavigation.topics.map((topic) => ({
    label: topic.depth > 0 ? `${"› ".repeat(topic.depth)}${topic.label}` : topic.label,
    href: topic.path.length > 0 ? noteTopicHref(collectionNavigation.category, topic.path, locale) : undefined,
    items: topic.notes.map((entry) => ({
      href: noteHref(entry, locale),
      title: entry.data.title,
      current: entry.id === collectionNavigation.currentId,
    })),
  })),
};
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data.title,
  description: data.description,
  ...(data.createdAt ? { dateCreated: data.createdAt.toISOString() } : {}),
  dateModified: data.updatedAt.toISOString(),
  author: { "@type": "Person", name: SITE.author },
  inLanguage: data.language === "en" ? "en" : "zh-CN",
  mainEntityOfPage: new URL(canonicalPath, SITE.url).toString(),
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  noindex={!data.indexable || locale !== DEFAULT_LOCALE}
  type="article"
  canonicalPath={canonicalPath}
  locale={locale}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")} />
  <div class="shell content-shell content-shell--with-series">
    <ReadingExperience locale={locale} />
    <MobileReadingNavigation collection={mobileCollection} collectionTabLabel={ui.noteOutline} headings={headings} locale={locale} />
    <NoteCollectionIndex navigation={collectionNavigation} locale={locale} />
    <article class="note" data-pagefind-body lang={LOCALES[data.language].htmlLang}>
      <nav class="breadcrumb" aria-label={ui.breadcrumb}>
        <a href={localizePath(locale, "/notes/")}>{ui.notesTitle}</a>
        <span aria-hidden="true">/</span>
        <a href={categoryHref(data.category, locale)}>{data.categoryLabel}</a>
        {topicPath.map((segment, index) => (
          <>
            <span aria-hidden="true">/</span>
            <a href={noteTopicHref(data.category, topicPath.slice(0, index + 1), locale)}>{segment.label}</a>
          </>
        ))}
      </nav>

      <header class="note-header">
        <p class="eyebrow">NOTE</p>
        <h1 data-pagefind-meta="title">{data.title}</h1>
        {data.description && <p class="note-description">{data.description}</p>}
        <div class="note-meta">
          <span data-pagefind-filter="category">{data.categoryLabel}</span>
          {data.createdAt && <span>{ui.createdAt} <time datetime={data.createdAt.toISOString()}>{formatDate(data.createdAt, locale)}</time></span>}
          <span>{ui.updatedAt} <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt, locale)}</time></span>
          <span>{readingUi.readingTime(readingMinutes)}</span>
          {data.status === "historical" && <span class="historical-badge">historical</span>}
          {!data.indexable && !data.canonicalPath && <span>{locale === "en" ? "Organizing" : "整理中"}</span>}
        </div>
        {data.tags.length > 0 && (
          <div class="tag-list" aria-label={ui.tags}>
            {data.tags.map((tag) => <a href={noteTagHref(tag, locale)} rel="tag">{tag}</a>)}
          </div>
        )}
      </header>

      {locale === "en" && <p class="source-note">{ui.notesChineseNotice}</p>}
      {data.status === "historical" && (
        <p class="historical-note">
          {locale === "en"
            ? "This is a historical learning note and may contain outdated or incomplete understanding."
            : "这是历史学习笔记，可能存在过时或不完整的理解。"}
        </p>
      )}
      {data.canonicalPath && (
        <p class="source-note">
          {locale === "en" ? (
            <>This note now has a separately maintained <a href={data.canonicalPath}>article version</a>. The original learning record is kept here.</>
          ) : (
            <>这份笔记已有独立维护的<a href={data.canonicalPath}>文章版</a>。这里保留原始学习记录。</>
          )}
        </p>
      )}
      <div id="reading-start" class="reading-anchor" aria-hidden="true"></div>
      <div class="prose" data-reading-content>
        <slot />
      </div>
      <div id="reading-end" class="reading-anchor" aria-hidden="true"></div>
      <ContentReaction contentType="note" contentId={note.id} language={locale} />
      <RelatedContent
        headingId="related-articles-heading"
        title={relatedUi.relatedArticles}
        items={relatedArticles.map((article) => ({
          href: articleHref(article),
          title: article.data.title,
          description: article.data.description,
        }))}
      />
      {(collectionNavigation.previous || collectionNavigation.next) && (
        <NoteSequenceNavigation navigation={collectionNavigation} locale={locale} />
      )}
    </article>
    <TableOfContents headings={headings} locale={locale} />
  </div>
</BaseLayout>
