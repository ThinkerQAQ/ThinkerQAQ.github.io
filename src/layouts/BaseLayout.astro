---
import LocalizedAskBlog from "../components/LocalizedAskBlog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  DEFAULT_LOCALE,
  LOCALES,
  languageAlternativesForPath,
  localizePath,
  rssPath,
  type Locale,
  type LocaleAlternative,
} from "../config/i18n";
import { SITE } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  canonicalPath?: string;
  language?: string;
  locale?: Locale;
  languageAlternatives?: LocaleAlternative[];
}

const {
  title: providedTitle,
  description: providedDescription,
  noindex = false,
  type = "website",
  canonicalPath = Astro.url.pathname,
  locale = DEFAULT_LOCALE,
  language: providedLanguage,
  languageAlternatives: providedLanguageAlternatives,
} = Astro.props;
const localeInfo = LOCALES[locale];
const title = providedTitle ?? SITE.title;
const description = providedDescription ?? localeInfo.siteDescription;
const language = providedLanguage ?? localeInfo.htmlLang;
const languageAlternatives = providedLanguageAlternatives ?? languageAlternativesForPath(Astro.url.pathname);
const homePath = localizePath(locale, "/");
const pageTitle =
  title === SITE.title && Astro.url.pathname === homePath
    ? localeInfo.homeTitle
    : title === SITE.title
      ? title
      : `${title} · ${SITE.title}`;
const canonical = new URL(canonicalPath, SITE.url);
const defaultAlternative = languageAlternatives.find(
  (alternative) => alternative.locale === DEFAULT_LOCALE,
);
const feedPath = rssPath(locale);
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
const umamiDomain = new URL(SITE.url).hostname;
const askBlogWorkerUrl = import.meta.env.PUBLIC_ASK_BLOG_WORKER_URL?.trim();
let umamiProxyOrigin = "";
if (askBlogWorkerUrl) {
  try {
    umamiProxyOrigin = new URL(askBlogWorkerUrl).origin;
  } catch {
    umamiProxyOrigin = "";
  }
}
const umamiScriptUrl = umamiProxyOrigin ? `${umamiProxyOrigin}/u.js` : "";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    {languageAlternatives.map((alternative) => (
      <link
        rel="alternate"
        hreflang={LOCALES[alternative.locale].htmlLang}
        href={new URL(alternative.href, SITE.url)}
      />
    ))}
    {defaultAlternative && (
      <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternative.href, SITE.url)} />
    )}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title={localeInfo.rss.title} href={feedPath} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={language.replace("-", "_")} />
    {languageAlternatives
      .filter((alternative) => alternative.locale !== locale)
      .map((alternative) => (
        <meta
          property="og:locale:alternate"
          content={LOCALES[alternative.locale].htmlLang.replace("-", "_")}
        />
      ))}
    <meta name="twitter:card" content="summary" />
    {umamiWebsiteId && umamiProxyOrigin && (
      <script
        is:inline
        defer
        src={umamiScriptUrl}
        data-website-id={umamiWebsiteId}
        data-domains={umamiDomain}
        data-host-url={umamiProxyOrigin}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{localeInfo.ui.skipToContent}</a>
    <SiteHeader locale={locale} languageAlternatives={languageAlternatives} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <LocalizedAskBlog locale={locale} />
  </body>
</html>
