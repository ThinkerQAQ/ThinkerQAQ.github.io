---
import AskBlog from "../components/AskBlog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE } from "../config/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  canonicalPath?: string;
  language?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  type = "website",
  canonicalPath = Astro.url.pathname,
  language = SITE.locale,
} = Astro.props;
const pageTitle =
  title === SITE.title && Astro.url.pathname === "/"
    ? SITE.homeTitle
    : title === SITE.title
      ? title
      : `${title} · ${SITE.title}`;
const canonical = new URL(canonicalPath, SITE.url);
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
const umamiDomain = new URL(SITE.url).hostname;
const askBlogWorkerUrl = import.meta.env.PUBLIC_ASK_BLOG_WORKER_URL?.trim();
let umamiProxyOrigin = "";
if (askBlogWorkerUrl) {
  try {
    umamiProxyOrigin = new URL(askBlogWorkerUrl).origin;
  } catch {
    umamiProxyOrigin = "";
  }
}
const umamiScriptUrl = umamiProxyOrigin ? `${umamiProxyOrigin}/u.js` : "";
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    {umamiWebsiteId && umamiProxyOrigin && (
      <script
        is:inline
        defer
        src={umamiScriptUrl}
        data-website-id={umamiWebsiteId}
        data-domains={umamiDomain}
        data-host-url={umamiProxyOrigin}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <AskBlog />
  </body>
</html>
