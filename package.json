{
  "name": "thinkerqaq-digital-garden",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-with-drafts.mjs run dev:site",
    "dev:site": "npm run diagrams && astro dev",
    "sync:notes": "node scripts/import-vnotes.mjs",
    "seed:articles": "node scripts/seed-articles.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "diagrams:plantuml": "node scripts/render-plantuml.mjs",
    "diagrams:drawio": "node scripts/render-drawio.mjs",
    "check:drawio": "node scripts/render-drawio.mjs --check",
    "test:diagrams": "npm run diagrams && node --test scripts/plantuml/plantuml.test.mjs scripts/drawio/drawio.test.mjs",
    "test:indexnow": "node --test scripts/indexnow.test.mjs",
    "indexnow:prepare": "node scripts/indexnow.mjs prepare",
    "indexnow:submit": "node scripts/indexnow.mjs submit",
    "build": "node scripts/clean-dist.mjs && npm run diagrams && astro build && node scripts/build-search.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "build:local": "node scripts/run-with-drafts.mjs run build",
    "local": "npm run build:local && astro preview --background --open",
    "stop:local": "astro preview stop",
    "verify": "node scripts/verify-build.mjs",
    "test": "npm run test:diagrams && npm run test:indexnow && npm run check && npm run build && npm run verify"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.4.0",
    "pagefind": "1.5.2",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  }
}
