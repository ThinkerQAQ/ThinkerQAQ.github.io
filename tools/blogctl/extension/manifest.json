{
  "manifest_version": 3,
  "name": "BlogCTL Extension",
  "version": "0.1.61",
  "key": "",
  "description": "Browser integration for BlogCTL. Shows publishing-platform login status, manages the local bridge and proxy configuration, and hands short-lived platform sessions to native publishers without persisting browser credentials.",
  "permissions": [
    "cookies",
    "webRequest",
    "nativeMessaging",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*.cnblogs.com/*",
    "https://*.juejin.cn/*",
    "https://*.csdn.net/*",
    "https://*.segmentfault.com/*",
    "https://*.zhihu.com/*",
    "https://*.51cto.com/*",
    "https://*.oschina.net/*",
    "https://*.toutiao.com/*",
    "https://dev.to/*",
    "https://medium.com/*",
    "http://127.0.0.1:32145/*",
    "https://cnblogs.com/*",
    "https://juejin.cn/*",
    "https://csdn.net/*",
    "https://segmentfault.com/*",
    "https://zhihu.com/*",
    "https://51cto.com/*",
    "https://oschina.net/*",
    "https://toutiao.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_title": "打开 BlogCTL 侧边栏"
  }
}
